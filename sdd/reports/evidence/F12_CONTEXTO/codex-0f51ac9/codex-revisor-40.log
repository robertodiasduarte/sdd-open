/bin/zsh -lc "cat sdd/features/DEFINE_PEDIDOS.md; sed -n '35,135p' sdd/bin/sdd-fluxo.sh; cat sdd/templates/fragments/RESUMO_ETAPA.md" in /var/folders/_s/_r8ph5yx5vgbqp_knw08v1380000gn/T/tmp.EtGv3b5E3y/b
