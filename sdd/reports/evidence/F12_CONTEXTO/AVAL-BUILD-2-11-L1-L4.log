# sonda L1 (ordem das chaves do cabeçalho) e L4 (lints chamados de subpasta com caminho relativo)
S="$1"; cd "$S"; B=sdd/fixtures/contexto/valido-completo.md; D=$(mktemp -d)
lint() { bash sdd/bin/contexto-lint.sh --dominio sdd/fixtures/contexto/dominio.md --playbook sdd/fixtures/contexto/playbook.md "$1" > "$D/o" 2>&1; rc=$?; grep -E '🛑|RESULTADO' "$D/o"; echo "rc=$rc"; }
echo '>>> L1: sup antes de ctx'
awk '/^ctx: /{c=$0; next} /^sup: /{print; print c; next} {print}' "$B" > "$D/a.md"; sed -n 3,7p "$D/a.md"; lint "$D/a.md"
echo '>>> L1: sha e gerado_em trocados'
awk '/^gerado_em: /{g=$0; next} /^sha: /{print; print g; next} {print}' "$B" > "$D/b.md"; sed -n 3,7p "$D/b.md"; lint "$D/b.md"
echo '>>> L1: ordem certa, linha em branco entre as chaves (deve passar)'
awk '/^sha: /{print; print ""; next} {print}' "$B" > "$D/c.md"; lint "$D/c.md"
echo '>>> L1: chave duplicada no fim (ctx: repetido depois de sup:)'
awk '/^sup: /{print; print "ctx: ctx:pedidos"; next} {print}' "$B" > "$D/d.md"; lint "$D/d.md"
echo '=== L4: de sdd/fixtures, caminhos relativos à subpasta'
cd sdd/fixtures
bash ../bin/contexto-lint.sh --dominio contexto/dominio.md --playbook contexto/playbook.md contexto/valido-completo.md > "$D/o" 2>&1; echo "contexto-lint lint rc=$?"; grep RESULTADO "$D/o"
bash ../bin/contexto-lint.sh --dominio contexto/dominio.md --sugerir contexto/INPUT_FIXTURE_PEDIDOS.md --dir contexto --ref HEAD > "$D/o" 2>&1; echo "contexto-lint --sugerir rc=$?"; grep -E 'recomendacao|ctx:' "$D/o"
H=$(git rev-parse HEAD); sed "s/__SHA__/$H/" contexto/validade-template.md > "$D/v.md"
bash ../bin/contexto-lint.sh --validade contexto/valido-completo.md --ref HEAD > "$D/o" 2>&1; echo "contexto-lint --validade (rel) rc=$?"; grep -E 'RESULTADO|sha-inex' "$D/o"
mkdir -p "$D/pat"; cp patterns/valido-vencido.md "$D/pat/x.md"
bash ../bin/patterns-lint.sh --playbook contexto/playbook.md patterns > "$D/o" 2>&1; echo "patterns-lint pasta rel rc=$?"; grep -E 'RESULTADO|pasta inex' "$D/o"
bash ../bin/patterns-lint.sh --playbook contexto/playbook.md --design patterns/DESIGN_FIXTURE_CITA_PEDIDOS.md patterns > "$D/o" 2>&1; echo "patterns-lint --design rel rc=$?"; grep -E 'RESULTADO|inexist|🛑' "$D/o"
echo '=== L4 reverso: nome que existe na subpasta E na raiz (sdd/fixtures/contexto vs ./contexto?)'
cd "$S"; mkdir -p sub; cd sub
bash ../sdd/bin/patterns-lint.sh ../sdd/patterns > "$D/o" 2>&1; echo "patterns-lint ../sdd/patterns de sub/ rc=$?"; grep RESULTADO "$D/o"
cd "$S"; rmdir sub
