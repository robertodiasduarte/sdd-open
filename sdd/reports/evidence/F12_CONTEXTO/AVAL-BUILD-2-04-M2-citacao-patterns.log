# sonda M2: variações da linha de citação contra um pattern vencido (2020-01-01)
S="$1"; cd "$S"; D=$(mktemp -d); mkdir "$D/pat"; cp sdd/fixtures/patterns/valido-vencido.md "$D/pat/pedidos.md"
L='`patterns/pedidos.md §Esqueleto` (validado_em 2020-01-01) — adaptações: nenhuma.'
run() { printf '## Code Patterns\n\n%s\n' "$2" > "$D/DESIGN_X.md"; echo ">>> $1"; sed 's/^/    | /' "$D/DESIGN_X.md"
  bash sdd/bin/patterns-lint.sh --playbook sdd/fixtures/contexto/playbook.md --design "$D/DESIGN_X.md" "$D/pat" > "$D/out" 2>&1; rc=$?
  grep -E 'validado-vencido|nenhum pattern citado' "$D/out"; echo "rc=$rc"; }
echo '=== DESIGN_TEMPLATE.md do pacote (blockquote de orientação) ==='
bash sdd/bin/patterns-lint.sh --playbook sdd/fixtures/contexto/playbook.md --design sdd/templates/DESIGN_TEMPLATE.md "$D/pat"; echo "rc=$?"
run 'forma canônica'               "**Pattern:** $L"
run 'exemplo em cerca ```'          "$(printf '```markdown\n**Pattern:** %s\n```' "$L")"
