rm -rf $B/old $B/new; mkdir -p $B/old $B/new; (cd $PKG && git archive 69b7f6b) | tar -x -C $B/old; (cd $PKG && git archive HEAD) | tar -x -C $B/new
for v in old new; do
  F=$B/fx-$v; rm -rf $F; mkdir -p $F; cd $F; git init -q -b main; git config user.email a@b; git config user.name t
