  echo "===== $v: doctor (linhas com .env/.pfx/.pem)"; bash $B/$v/bin/sdd-open.sh doctor 2>&1 | grep -E '\.env|\.pfx|\.pem|segredo|certificado' ; echo "exit=${PIPESTATUS[0]}"
done
