$ cat /var/folders/_s/_r8ph5yx5vgbqp_knw08v1380000gn/T/tmp.IaPhB1vDIh/p02.sh; /bin/bash /var/folders/_s/_r8ph5yx5vgbqp_knw08v1380000gn/T/tmp.IaPhB1vDIh/p02.sh
. $(dirname "$0")/lab.sh
caso() { echo; echo "=== $1"; ( shift; "$@" ) 2>&1; }
ct() { [ -f gate.calls ] && echo "gate.calls=$(wc -l < gate.calls | tr -d " ")" || echo "gate.calls=0"; }
base() { mkrepo "$(novo)"; echo print > codigo.py; chmod 644 codigo.py; git add -A; git commit -qm cod; verde >/dev/null 2>&1; ct; }
# submodule: repo lib com 2 commits; o principal aponta para o 1o
sub_add() { # sub_add <ignore|->
  L="$(novo)"; ( cd "$L"; git init -q; echo v1 > lib.txt; git add -A; git commit -qm v1; echo v2 > lib.txt; git add -A; git commit -qm v2 )
  V1=$(git -C "$L" rev-parse HEAD~1); V2=$(git -C "$L" rev-parse HEAD)
  mkrepo "$(novo)"; git -c protocol.file.allow=always submodule --quiet add "$L" sub; git -C sub checkout -q "$V1"; git add sub
  [ "$1" != "-" ] && git config -f .gitmodules submodule.sub.ignore "$1"
  git add -A; git commit -qm sub; verde >/dev/null 2>&1; ct; gates
}
s_normal() { sub_add -; git -C sub checkout -q "$V2"; git status --porcelain | grep -v "^??"; drv concluir $D; git add sub; git commit -qm ponteiro; git diff --name-only --no-renames HEAD~1 HEAD; drv concluir $D; ct; }
s_all() { sub_add all; git -C sub checkout -q "$V2"; echo "status:"; git status --porcelain | grep -v "^??"; echo "concluir com o submodulo noutra versao, sem commit:"; drv concluir $D; git add -f sub; git commit -qm ponteiro; echo "ls-tree:"; git ls-tree HEAD sub; echo "name-only:"; git diff --name-only --no-renames HEAD~1 HEAD; drv concluir $D; ct; }
s_cfg() { sub_add -; git config diff.ignoreSubmodules all; git -C sub checkout -q "$V2"; git update-index --add --cacheinfo 160000,$V2,sub; git commit -qm ponteiro; git ls-tree HEAD sub; drv concluir $D; ct; }
s_dirty() { sub_add dirty; echo sujo > sub/lib.txt; git status --porcelain | grep -v "^??"; drv concluir $D; ct; }
s_doc() { sub_add -; mkdir -p sdd/reports; echo; git -C sub checkout -q "$V2"; drv concluir $D; ct; }
# indice mentiroso
i_skip() { base; git update-index --skip-worktree codigo.py; echo conserto-so-local > codigo.py; git status --porcelain | grep -v "^??"; drv concluir $D; ct; }
i_skip2() { mkrepo "$(novo)" "echo x >> gate.calls; grep -q conserto codigo.py"; echo print > codigo.py; git add -A; git commit -qm cod; git update-index --skip-worktree codigo.py; echo conserto-so-local > codigo.py; drv iniciar $D > /dev/null; feito; rel; drv verificar $D; drv concluir $D; ct; echo "o commit testado:"; git show HEAD:codigo.py; }
i_assume() { base; git update-index --assume-unchanged codigo.py; echo mudou > codigo.py; git status --porcelain | grep -v "^??"; drv concluir $D; ct; }
i_mode() { base; git config core.fileMode false; chmod +x codigo.py; git status --porcelain | grep -v "^??"; drv concluir $D; ct; }
for c in s_normal s_all s_cfg s_dirty i_skip i_skip2 i_assume i_mode; do caso $c $c; done

