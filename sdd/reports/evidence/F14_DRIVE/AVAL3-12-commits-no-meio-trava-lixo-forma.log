$ cat /var/folders/_s/_r8ph5yx5vgbqp_knw08v1380000gn/T/tmp.IaPhB1vDIh/p11.sh; /bin/bash /var/folders/_s/_r8ph5yx5vgbqp_knw08v1380000gn/T/tmp.IaPhB1vDIh/p11.sh
. $(dirname "$0")/lab.sh
caso() { echo; echo "=== $1"; ( shift; "$@" ) 2>&1; }
G="echo \$\$ >> gate.calls; while [ ! -f .go ]; do sleep 0.1; done; test -f .verde"
L=sdd/reports/progress/DRIVE_F.lock
esp() { i=0; while [ $i -lt 100 ]; do [ -f gate.calls ] && [ "$(wc -l < gate.calls | tr -d " ")" -ge "$1" ] && return 0; sleep 0.1; i=$((i+1)); done; echo "TIMEOUT"; return 1; }
espl() { i=0; while [ $i -lt 100 ]; do [ ! -f $L ] && return 0; sleep 0.1; i=$((i+1)); done; echo "TIMEOUT trava"; return 1; }
prep() { mkrepo "$(novo)" "$G"; echo print > codigo.py; git add -A; git commit -qm c; touch .verde; drv iniciar $D >/dev/null; feito; rel; }
ed() { /usr/bin/python3 -I -B -c "import json;p=\"sdd/reports/progress/DRIVE_F.json\";d=json.load(open(p));$1;json.dump(d,open(p,\"w\"))"; }
m1() { prep; /bin/bash sdd/bin/sdd-drive.sh verificar $D --fundo >/dev/null; esp 1; git mv codigo.py sdd/reports/codigo.py; git commit -qm mv; touch .go; espl; gates; drv concluir $D; }
m2() { prep; /bin/bash sdd/bin/sdd-drive.sh verificar $D --fundo >/dev/null; esp 1; mv codigo.py ../fora-$$; git add -u codigo.py; git commit -qm del; touch .go; espl; drv concluir $D; }
m3() { prep; /bin/bash sdd/bin/sdd-drive.sh verificar $D --fundo >/dev/null; esp 1; echo x >> codigo.py; git add codigo.py; git commit -q --amend -m am; touch .go; espl; drv concluir $D; }
m4() { prep; /bin/bash sdd/bin/sdd-drive.sh verificar $D --fundo >/dev/null; esp 1; git reset -q --hard HEAD~1; touch .go; espl; drv concluir $D; }
m5() { prep; A=$(git rev-parse HEAD); /bin/bash sdd/bin/sdd-drive.sh verificar $D --fundo >/dev/null; esp 1; define "false" > $D; git add $D; git commit -qm troca; drv --resume $D --aceitar-gate-novo; touch .go; espl; gates; drv concluir $D; }
m6() { mkrepo "$(novo)" "false"; echo print > codigo.py; git add -A; git commit -qm c; drv iniciar $D > /dev/null; feito; rel; drv verificar $D; git mv codigo.py sdd/reports/codigo.py; git commit -qm mv; drv proximo $D; drv concluir $D; }
m7() { mkrepo "$(novo)"; verde > /dev/null 2>&1; mv .verde ../fora-$$; drv concluir $D; echo "o gate agora:"; test -f .verde; echo "rc=$?"; }
m8() { prep; touch .go; /bin/bash sdd/bin/sdd-drive.sh verificar $D > /dev/null; gates; /bin/bash sdd/bin/sdd-drive.sh verificar $D; echo "[rc=$?]"; gates; }
# trava com lixo
t_lixo() { for v in -1 0 abc "" 99999999999999999999 " 12 " 1; do mkrepo "$(novo)" "true"; drv iniciar $D > /dev/null; feito; rel; printf "%s" "$v" > $L; echo "--- trava=[$v]"; /bin/bash sdd/bin/sdd-drive.sh proximo $D 2>&1 | grep -E "^ACAO|🛑|motivo:"; echo "[rc=${PIPESTATUS[0]}]"; done; }
# forma do estado
e_forma() { for ex in "d[\"motivo\"]=\"xyz\"" "d[\"motivo\"]=3" "d[\"motivo\"]=[]" "d[\"motivo\"]={}" "d[\"parada_gate\"]=[]" "d[\"parada_gate\"]=\"xyz\"" "d[\"detalhe\"]=3" "d[\"gate_linhas\"]=3" "d[\"gate_linhas\"]=[3]" "d[\"maximo\"]=0" "d[\"maximo\"]=-1" "d[\"maximo\"]=True" "d[\"versao\"]=99" "d[\"versao\"]=1" "d[\"feature\"]=\"OUTRA\"" "d[\"gates\"]=[dict(n=1,rodada=1,commit=\"a\",log=\"l\",impressao=\"i\",exit=True)]" "d[\"gates\"]=[dict(n=1.5,rodada=1,commit=\"a\",log=\"l\",impressao=\"i\",exit=0)]" "d[\"repeticao\"]=3" "d[\"repeticao\"]=dict(chave=\"\")" "d[\"recibos\"]=[1]" "d[\"trocas_gate\"]=[1]" "d[\"inicio\"]=\"\"" "d[\"avisou_paradas\"]=[]" "d[\"repeticao\"]=dict(chave=\"\",n=-5)"; do mkrepo "$(novo)" "true"; drv iniciar $D > /dev/null; ed "$ex"; for v in proximo concluir; do out=$(/bin/bash sdd/bin/sdd-drive.sh $v $D 2>&1); rc=$?; echo "$ex | $v | rc=$rc | $(echo "$out" | grep -E "^motivo:|^ACAO:|🛑" | head -1 | cut -c1-90)"; done; out=$(/bin/bash sdd/bin/sdd-drive.sh recibo $D r 2>&1); echo "$ex | recibo | rc=$? | $(echo "$out" | grep -E "^motivo:|🛑|anotado" | head -1 | cut -c1-70)"; done; }
for c in m1 m2 m3 m4 m5 m6 m7 m8 t_lixo e_forma; do caso $c $c; done

