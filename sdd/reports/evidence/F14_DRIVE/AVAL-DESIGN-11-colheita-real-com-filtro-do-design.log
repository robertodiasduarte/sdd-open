$ T=$(mktemp -d); mkdir $T/antes $T/depois; cp sdd/reports/evidence/F14_PLAYBOOK/AVAL*-*.log $T/antes/; /usr/bin/python3 -B -c "
import glob,os,re,sys
a,d=sys.argv[1],sys.argv[2]
F=re.compile(r\"^(\\$ |❌ (delta|invariantes) linha \d+:|🔴 trava INV:)\")
n=0
for f in glob.glob(a+\"/*.log\"):
    s=[]
    for ln in open(f,encoding=\"utf-8\",errors=\"replace\").read().split(\"\n\"):
        if F.match(ln): n+=1; s.append(\"\")
        else: s.append(ln)
    open(os.path.join(d,os.path.basename(f)),\"w\",encoding=\"utf-8\").write(\"\n\".join(s))
print(\"linhas removidas pelo filtro do Decision 11:\",n)
" $T/antes $T/depois; echo "=== colheita SEM filtro"; bash sdd/bin/playbook-curator.sh --colher $T/antes sdd/playbook.md; echo "exit=$?"; echo "=== colheita COM o filtro do Decision 11"; bash sdd/bin/playbook-curator.sh --colher $T/depois sdd/playbook.md; echo "exit=$?"; echo "=== linhas de origem de cada DELTA restante"; /usr/bin/python3 -B -c "
import glob,re,subprocess,sys,os
d=sys.argv[1]
s=subprocess.run([\"bash\",\"sdd/bin/playbook-curator.sh\",\"--colher\",d,\"sdd/playbook.md\"],capture_output=True,text=True).stdout
for ln in s.split(\"\n\"):
    m=re.match(r\"^DELTA (LM-\d+) mordeu.*evidencia=(.+?):(\d+)\",ln)
    if m:
        t=open(os.path.join(d,m.group(2)),encoding=\"utf-8\",errors=\"replace\").read().split(\"\n\")[int(m.group(3))-1]
        print(m.group(1),m.group(2)+\":\"+m.group(3),\"::\",t[:200])
" $T/depois; rm -rf $T
