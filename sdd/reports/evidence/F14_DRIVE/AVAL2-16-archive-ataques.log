# doc <caminho>: arquivo rastreado num commit velho
doc() { mkdir -p "$(dirname "$1")"; echo x > "$1"; git add -- "$1"; GIT_AUTHOR_DATE="2020-01-01T00:00:00" GIT_COMMITTER_DATE="2020-01-01T00:00:00" git commit -q -m "d $1"; }
ficha() { # ficha <nome> <status> [corpo]
  mkdir -p sdd/handoffs; printf '# H\n\n## Ficha\n\n| Campo | Valor |\n|---|---|\n| **Objetivo** | o |\n| **Status** | %s |\n| **Verify Gate** | v |\n\n%s\n' "$2" "${3:-}" > "sdd/handoffs/HANDOFF_$1.md"; }
tot() { $ARQ "$@" 2>&1 | grep -E '^TOTAIS|^  .*(→|ficha|citad)'; echo "[rc=${PIPESTATUS[0]}]"; }
novoa() { mkarq "$(novo)"; }
