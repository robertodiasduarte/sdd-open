$ cat /var/folders/_s/_r8ph5yx5vgbqp_knw08v1380000gn/T/tmp.IaPhB1vDIh/p03.sh; /bin/bash /var/folders/_s/_r8ph5yx5vgbqp_knw08v1380000gn/T/tmp.IaPhB1vDIh/p03.sh
. $(dirname "$0")/lab.sh
caso() { echo; echo "=== $1"; ( shift; "$@" ) 2>&1; }
ct() { [ -f gate.calls ] && echo "gate.calls=$(wc -l < gate.calls | tr -d " ")" || echo "gate.calls=0"; }
base() { mkrepo "$(novo)"; echo print > codigo.py; git add -A; git commit -qm cod; verde >/dev/null 2>&1; ct; }
ed() { /usr/bin/python3 -I -B -c "import json;p=\"sdd/reports/progress/DRIVE_F.json\";d=json.load(open(p));$1;json.dump(d,open(p,\"w\"))"; }
# HEAD que recua ou some
h_recua() { base; echo novo > codigo.py; git add codigo.py; git commit -qm c2; touch .verde; drv verificar $D; git reset -q --hard HEAD~1; gates; git log --format=%h -1; drv concluir $D; ct; }
h_some() { base; echo c2 > codigo.py; git add codigo.py; git commit -qm c2; drv verificar $D; gates; git reset -q --hard HEAD~1; git reflog expire --expire=now --all; git gc -q --prune=now; git cat-file -t $(st "print(d[\"gates\"][-1][\"commit\"])") ; drv concluir $D; ct; }
h_amend_cod() { base; echo c2 >> codigo.py; git add codigo.py; git commit -q --amend -m am; drv concluir $D; ct; }
h_amend_same() { base; git commit -q --amend -m "so a mensagem"; drv concluir $D; ct; }
h_amend_doc() { base; mkdir -p sdd/reports; echo d > sdd/reports/n.md; git add -f sdd/reports/n.md; git commit -q --amend -m am; drv concluir $D; ct; }
h_soft() { base; git reset -q --soft HEAD~1; drv concluir $D; ct; git commit -qm mesmo; drv concluir $D; ct; }
h_rebase_vazio() { base; A=$(git rev-parse HEAD); git checkout -q -b outra; echo y > y.txt; git add y.txt; git commit -qm y; git checkout -q frente; git merge -q --no-edit outra; drv concluir $D; ct; }
h_inicio_some() { base; git checkout -q --orphan nova; git commit -qm raiz; git branch -q -D frente; git reflog expire --expire=now --all; git gc -q --prune=now; drv concluir $D; ct; drv proximo $D; }
h_branch() { base; git checkout -q -b main; git status --porcelain | grep -v "^??"; git branch --show-current; drv proximo $D; drv concluir $D; }
h_detached() { base; git checkout -q --detach; drv concluir $D; }
h_verif_main() { mkrepo "$(novo)"; touch .verde; drv iniciar $D > /dev/null; feito; rel; git checkout -q -b main; drv verificar $D; ct; }
# concluir repetido
c_rep() { base; drv concluir $D; drv concluir $D; drv concluir $D; ct; echo x >> codigo.py; git add codigo.py; git commit -qm c; drv concluir $D; ct; }
# bloqueio e concluir
c_bloq() { base; drv bloqueio $D "preciso do responsavel"; drv concluir $D; st "print(d[\"motivo\"])"; }
c_bloq3() { base; drv proximo $D; drv proximo $D; drv proximo $D; drv concluir $D; }
c_rel() { base; echo x >> codigo.py; git add codigo.py; git commit -qm c; drv verificar $D; ct; echo "BUILD_REPORT e o velho, de antes do codigo novo"; drv concluir $D; }
# gate trocado e voltado
g_ida_volta() { base; define "true" > $D; drv proximo $D; drv --resume $D --aceitar-gate-novo; drv concluir $D; define "echo x >> gate.calls; test -f .verde" > $D; drv --resume $D --aceitar-gate-novo; drv concluir $D; ct; }
g_ida_vermelho() { base; define "false" > $D; drv --resume $D --aceitar-gate-novo; drv verificar $D; gates; define "echo x >> gate.calls; test -f .verde" > $D; drv --resume $D --aceitar-gate-novo; drv concluir $D; ct; }
# estado editado
e_forja() { mkrepo "$(novo)" "false"; drv iniciar $D > /dev/null; feito; rel; H=$(git rev-parse HEAD); S=$(st "print(d[\"gate_sha\"])"); ed "d[\"gates\"].append(dict(n=1,rodada=1,commit=\"$H\",exit=0,log=\"nao/existe.log\",impressao=\"$S\"))"; drv concluir $D; }
e_forja_head() { mkrepo "$(novo)" "false"; drv iniciar $D > /dev/null; feito; rel; S=$(st "print(d[\"gate_sha\"])"); ed "d[\"gates\"].append(dict(n=1,rodada=1,commit=\"HEAD\",exit=0,log=\"x\",impressao=\"$S\"))"; echo novo > c.txt; git add c.txt; git commit -qm c; drv concluir $D; }
e_troca_sha() { base; define "false" > $D; S=$(/bin/bash sdd/bin/verify-gate.sh --print $D | /usr/bin/python3 -I -B -c "import sys,re,hashlib;print(hashlib.sha256(chr(10).join(l for l in sys.stdin.read().split(chr(10)) if re.match(\"^(kind|cmd|pass_when|threshold|manual_fallback):\",l)).encode()).hexdigest())"); ed "d[\"gate_sha\"]=\"$S\"; d[\"gates\"][-1][\"impressao\"]=\"$S\""; drv concluir $D; }
e_opcao() { mkrepo "$(novo)" "false"; drv iniciar $D > /dev/null; feito; rel; S=$(st "print(d[\"gate_sha\"])"); ed "d[\"gates\"].append(dict(n=1,rodada=1,commit=\"--output=INJETADO\",exit=0,log=\"x\",impressao=\"$S\"))"; drv concluir $D; ls INJETADO; }
for c in h_recua h_some h_amend_cod h_amend_same h_amend_doc h_soft h_rebase_vazio h_inicio_some h_branch h_detached h_verif_main c_rep c_bloq c_bloq3 c_rel g_ida_volta g_ida_vermelho e_forja e_forja_head e_troca_sha e_opcao; do caso $c $c; done

