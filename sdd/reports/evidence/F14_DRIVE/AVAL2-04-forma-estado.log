$ cat /var/folders/_s/_r8ph5yx5vgbqp_knw08v1380000gn/T/tmp.5rZgwRfwzB/forma.sh; /bin/bash /var/folders/_s/_r8ph5yx5vgbqp_knw08v1380000gn/T/tmp.5rZgwRfwzB/forma.sh
# forma.sh: uma mutacao por vez do estado valido; proximo, recibo, concluir, --resume e bloqueio devem dar estado-invalido (20), nunca 1 nem 2
. /var/folders/_s/_r8ph5yx5vgbqp_knw08v1380000gn/T/tmp.5rZgwRfwzB/lab.sh
mkrepo "$(novo)"; drv iniciar $D > /dev/null; feito; drv verificar $D > /dev/null 2>&1
cp sdd/reports/progress/DRIVE_F.json $LAB/base.json
muta() { /usr/bin/python3 -I -B - "$1" <<'PY'
import json,sys
d=json.load(open("sdd/reports/progress/DRIVE_F.json"))
exec(sys.argv[1])
json.dump(d,open("sdd/reports/progress/DRIVE_F.json","w"))
PY
}
for m in 'd["motivo"]="xyz"' 'd["motivo"]=3' 'd["motivo"]=None' 'd["detalhe"]=3' 'd["detalhe"]=["a"]' 'd["gate_linhas"]=3' 'd["parada_gate"]=3' 'd["parada_gate"]="xyz"' 'd["avisou_paradas"]="x"' 'd["maximo"]=0' 'd["maximo"]=-1' 'd["versao"]="abc"' 'd["versao"]=99' 'd["feature"]="OUTRA"' 'd["gates"][0]["exit"]=True' 'd["gates"][0]["rodada"]=-5' 'd["repeticao"]={"chave":"","n":-1}' 'del d["motivo"]' 'del d["gate_linhas"]' 'd["gate_sha"]=""' 'd["inicio"]=""' ; do
  for v in proximo concluir "--resume" recibo bloqueio; do
    cp $LAB/base.json sdd/reports/progress/DRIVE_F.json; muta "$m"
    extra=""; if [ "$v" = recibo ] || [ "$v" = bloqueio ]; then extra="texto"; fi
    if [ -n "$extra" ]; then out=$(/bin/bash sdd/bin/sdd-drive.sh $v $D "$extra" 2>&1); else out=$(/bin/bash sdd/bin/sdd-drive.sh $v $D 2>&1); fi; rc=$?
    printf '%-42s %-9s rc=%s %s\n' "$m" "$v" "$rc" "$(printf '%s' "$out" | grep -E '^(motivo:|ACAO:|🛑|Traceback)' | head -1)"
  done
done
