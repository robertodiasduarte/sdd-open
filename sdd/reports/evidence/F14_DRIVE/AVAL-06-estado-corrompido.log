$ . /var/folders/_s/_r8ph5yx5vgbqp_knw08v1380000gn/T/tmp.RRzJHrBpTz/lab.sh; V=$(novo); mkrepo $V/x "false"; drv iniciar $D; S=sdd/reports/progress/DRIVE_F.json; cp $S $V/bom.json
muda() { python3 - "$1" <<PY
import json,sys
s=json.load(open("$V/bom.json")); s.update(json.loads(sys.argv[1])); json.dump(s,open("$S","w"))
PY
}
for c in "{\"gates\":[{}]}" "{\"gates\":[1]}" "{\"repeticao\":{\"chave\":\"x\"}}" "{\"repeticao\":3}" "{\"recibos\":3}" "{\"trocas_gate\":3}" "{\"maximo\":0}" "{\"maximo\":-1}" "{\"maximo\":true}" "{\"gate_cmd\":null}" "{\"inicio\":null}" "{\"gates\":[{\"exit\":\"2\"}]}"; do
  echo "=== estado com $c"; muda "$c"
  for v in proximo concluir "--resume"; do /bin/bash sdd/bin/sdd-drive.sh $v $D > $V/o.txt 2>&1; rc=$?; echo "$v rc=$rc: $(grep -E "^(motivo|ACAO)|Error" $V/o.txt | head -n 2 | tr "\n" " ")"; done
  /bin/bash sdd/bin/sdd-drive.sh recibo $D texto > $V/o.txt 2>&1; rc=$?; echo "recibo rc=$rc: $(grep -E "^(motivo|ACAO)|Error" $V/o.txt | head -n 1)"
done
printf "nao e json" > $S; drv proximo $D
printf "[]" > $S; drv proximo $D
