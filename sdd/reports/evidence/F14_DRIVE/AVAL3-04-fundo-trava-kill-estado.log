$ cat /var/folders/_s/_r8ph5yx5vgbqp_knw08v1380000gn/T/tmp.IaPhB1vDIh/p04.sh; /bin/bash /var/folders/_s/_r8ph5yx5vgbqp_knw08v1380000gn/T/tmp.IaPhB1vDIh/p04.sh
. $(dirname "$0")/lab.sh
caso() { echo; echo "=== $1"; ( shift; "$@" ) 2>&1; }
ct() { [ -f gate.calls ] && echo "gate.calls=$(wc -l < gate.calls | tr -d " ")" || echo "gate.calls=0"; }
G="echo \$\$ >> gate.calls; while [ ! -f .go ]; do sleep 0.1; done; test -f .verde"
L=sdd/reports/progress/DRIVE_F.lock
esp() { i=0; while [ $i -lt 100 ]; do [ -f gate.calls ] && [ "$(wc -l < gate.calls | tr -d " ")" -ge "$1" ] && return 0; sleep 0.1; i=$((i+1)); done; echo "TIMEOUT esperando $1 gates"; return 1; }
espl() { i=0; while [ $i -lt 100 ]; do [ ! -f $L ] && return 0; sleep 0.1; i=$((i+1)); done; echo "TIMEOUT: trava continua"; return 1; }
prep() { mkrepo "$(novo)" "$G"; touch .verde; drv iniciar $D >/dev/null; feito; rel; }
filhos() { /bin/ps -axo pid,ppid,command | grep -E "sdd-drive|verify-gate|gate.calls" | grep -v grep | grep "$PWD\|sdd/bin\|gate.calls" | cut -c1-90; }
# a: mata o bash do filho do --fundo no meio do gate
f_kill_bash() { prep; drv verificar $D --fundo; esp 1; P=$(cat $L); echo "trava=$P"; kill -9 $P; sleep 0.3; echo "bash morto; python e gate seguem:"; filhos | wc -l | tr -d " "; drv proximo $D; drv verificar $D --fundo; esp 2; ct; P2=$(cat $L); echo "trava2=$P2"; touch .go; sleep 2; ct; gates; ls $L 2>/dev/null; drv proximo $D; }
# b: mata o python do filho
f_kill_py() { prep; drv verificar $D --fundo; esp 1; P=$(cat $L); PY=$(/usr/bin/pgrep -P $P | head -1); echo "bash=$P python=$PY"; kill -9 $PY; sleep 0.3; ls $L; drv proximo $D; gates; touch .go; sleep 0.5; gates; }
# c: mata o verify-gate
f_kill_vg() { prep; drv verificar $D --fundo; esp 1; P=$(cat $L); PY=$(/usr/bin/pgrep -P $P | head -1); VG=$(/usr/bin/pgrep -P $PY | head -1); echo "vg=$VG"; kill -9 $VG; espl; gates; drv proximo $D; drv --resume $D; touch .go; }
# d: mata o comando do gate
f_kill_cmd() { prep; drv verificar $D --fundo; esp 1; CMD=$(head -1 gate.calls); echo "cmd=$CMD"; kill -9 $CMD; espl; gates; tail -4 sdd/reports/evidence/F/DRIVE-gate-r1.log; drv proximo $D; }
f_kill_contains() { mkrepo "$(novo)" "echo \$\$ >> gate.calls; echo OK-PARCIAL; while [ ! -f .go ]; do sleep 0.1; done; echo FIM; false" "contains: OK-PARCIAL"; touch .verde; drv iniciar $D >/dev/null; feito; rel; drv verificar $D --fundo; esp 1; kill -9 $(head -1 gate.calls); espl; gates; drv concluir $D; }
# e: variavel de quem chama
v_sem_trava() { mkrepo "$(novo)"; drv iniciar $D >/dev/null; export SDD_DRIVE_TRAVA_HERDADA=1; drv verificar $D; ct; }
v_trava_morta() { prep; touch .go; /bin/bash -c "exit 0"; echo 99999 > $L; export SDD_DRIVE_TRAVA_HERDADA=1; time drv verificar $D; ct; ls $L 2>/dev/null; }
v_trava_viva() { prep; /bin/sleep 20 & V=$!; echo $V > $L; export SDD_DRIVE_TRAVA_HERDADA=1; drv verificar $D; ct; kill $V; }
v_forja() { mkrepo "$(novo)"; drv iniciar $D >/dev/null; /bin/bash -c "echo \$\$ > $L; exec env SDD_DRIVE_TRAVA_HERDADA=1 /bin/bash sdd/bin/sdd-drive.sh verificar $D"; echo "[rc=$?] tarefas pendentes, mas o gate:"; ct; gates; }
v_gate_nao_herda() { mkrepo "$(novo)" "echo VAR=[\${SDD_DRIVE_TRAVA_HERDADA:-}] ; test -f .verde"; touch .verde; drv iniciar $D > /dev/null; feito; rel; drv verificar $D --fundo; espl; grep VAR= sdd/reports/evidence/F/DRIVE-gate-r1.log; }
# g: estado muda durante o gate
m_apaga() { prep; drv verificar $D --fundo; esp 1; mv sdd/reports/progress/DRIVE_F.json ../fora-$$; touch .go; sleep 1.5; cat sdd/reports/progress/DRIVE_F.fundo.log | grep -E "motivo|Traceback"; ls $L 2>/dev/null; drv proximo $D; }
m_corrompe() { prep; drv verificar $D --fundo; esp 1; echo "{" > sdd/reports/progress/DRIVE_F.json; touch .go; sleep 1.5; grep -E "motivo|Traceback" sdd/reports/progress/DRIVE_F.fundo.log; ls $L 2>/dev/null; }
m_iniciar() { prep; drv verificar $D --fundo; esp 1; mv sdd/reports/progress/DRIVE_F.json ../fora-$$; drv iniciar $D; touch .go; espl; gates; drv concluir $D; }
m_recibo() { prep; drv verificar $D --fundo; esp 1; drv recibo $D "durante"; touch .go; espl; st "print(d[\"recibos\"],len(d[\"gates\"]))"; }
m_resume_max() { mkrepo "$(novo)" "echo x >> gate.calls; while [ ! -f .go ]; do sleep 0.1; done; false"; drv iniciar $D >/dev/null; feito; rel; drv verificar $D --fundo; esp 1; drv --resume $D --max 1; touch .go; espl; gates; grep -E "motivo" sdd/reports/progress/DRIVE_F.fundo.log; drv proximo $D; }
m_doc_commit() { prep; drv verificar $D --fundo; esp 1; echo d > sdd/reports/nota.md; git add -f sdd/reports/nota.md; git commit -qm doc; touch .go; espl; drv concluir $D; }
m_cod_commit() { prep; drv verificar $D --fundo; esp 1; echo d > c.py; git add c.py; git commit -qm cod; touch .go; espl; drv concluir $D; }
m_edit_volta() { mkrepo "$(novo)" "echo x >> gate.calls; while [ ! -f .go ]; do sleep 0.1; done; test -f fix.py"; drv iniciar $D > /dev/null; feito; rel; drv verificar $D --fundo; esp 1; echo x > fix.py; touch .go; espl; mv fix.py ../fora-$$; git status --porcelain | grep -v "^??"; gates; drv concluir $D; }
for c in f_kill_bash f_kill_py f_kill_vg f_kill_cmd f_kill_contains v_sem_trava v_trava_morta v_trava_viva v_forja v_gate_nao_herda m_apaga m_corrompe m_iniciar m_recibo m_resume_max m_doc_commit m_cod_commit m_edit_volta; do caso $c $c; done

