$ . /var/folders/_s/_r8ph5yx5vgbqp_knw08v1380000gn/T/tmp.RRzJHrBpTz/lab.sh; V=$(novo); s() { /bin/bash sdd/bin/sdd-drive.sh "$@" > $V/o 2>&1; rc=$?; echo "[$*] rc=$rc $(grep -E "^(motivo|ACAO|tarefa)" $V/o | head -n 2 | cut -c1-100 | tr "\n" ";")"; }
mkrepo $V/x "sleep 3; test -f .verde"; mv sdd/features/DESIGN_F.md $V/d.md; git add -A; git commit -qm sem-design
s iniciar $D
sed "s/Total Files:\*\* 2/Total Files:** 9/" $V/d.md > sdd/features/DESIGN_F.md; s proximo $D
