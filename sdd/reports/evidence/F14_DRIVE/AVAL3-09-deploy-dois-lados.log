# cen.py <dir> <python-expr>: grava cenario.json; R(id, sha, ...) monta um run
import json, sys
def R(i, s, st="completed", c="success", t="2026-01-01T00:00:00Z", b="main", e="push"):
    return dict(databaseId=i, headSha=s, headBranch=b, status=st, conclusion=c, createdAt=t, workflowName="deploy", event=e)
def J(nome, c, *passos):
    return dict(name=nome, conclusion=c, steps=[dict(name=n, conclusion=k) for n, k in passos])
d, expr = sys.argv[1], sys.argv[2]
X, Y, Z = (sys.argv[3:] + [""]*3)[:3]
json.dump(eval(expr), open(d + "/cenario.json", "w"))
. $(dirname "$0")/lab.sh
mkdep() { R="$1"; mkdir -p "$R"; git init -q --bare "$R/remoto.git"; mkdir -p "$R/clone"; cd "$R/clone" || exit 9; git init -q; git symbolic-ref HEAD refs/heads/main; echo 1 > a.txt; git add -A; git commit -q -m 1; git remote add origin "$R/remoto.git"; git push -q origin main; X=$(git rev-parse HEAD); GH_DIR="$R/gh"; mkdir -p "$GH_DIR"; export GH_DIR; export PATH="$LAB/ghshim:$PATH"; }
cen() { /usr/bin/python3 -I -B "$LAB/cen.py" "$GH_DIR" "$1" "$X" "${Y:-}" "${Z:-}"; : > "$GH_DIR/gh.log"; echo 0 > "$GH_DIR/pos"; echo 0 > "$GH_DIR/viewc"; }
dep() { /bin/bash "$PROJ/sdd/bin/deploy-do-sha.sh" "$@" 2>&1; echo "[rc=$?]"; }
d1() { dep --commit "$X" --workflow deploy.yml --intervalo 0 --teto 1 --sem-run 0 "$@"; }
disp() { echo "disparos: $(grep -c "^workflow run" "$GH_DIR/gh.log"); rerun: $(grep -c "rerun" "$GH_DIR/gh.log"); consultas: $(wc -l < "$GH_DIR/gh.log" | tr -d " ")"; ls .git/deploy-do-sha 2>/dev/null; }
caso() { echo; echo "=== $1"; ( mkdep "$(novo)"; "$2" ) 2>&1 | cut -c1-190; }
TR="--transitorios pass,pass2"
FALHO="R(1,X,c=\"failure\")"
d_todos() { cen "dict(passos=[dict(runs=[$FALHO]),dict(runs=[$FALHO]),dict(runs=[$FALHO,R(2,X,e=\"workflow_dispatch\",t=\"2026-01-02T00:00:00Z\")])],jobs=[J(\"a\",\"failure\",(\"pass\",\"failure\")),J(\"b\",\"failure\",(\"pass2\",\"failure\"))])"; d1 $TR; disp; }
d_um_real() { cen "dict(passos=[dict(runs=[$FALHO])],jobs=[J(\"a\",\"failure\",(\"pass\",\"failure\")),J(\"b\",\"failure\",(\"real\",\"failure\"))])"; d1 $TR; disp; }
d_job_sem() { cen "dict(passos=[dict(runs=[$FALHO])],jobs=[J(\"a\",\"failure\",(\"pass\",\"failure\")),J(\"b\",\"failure\",(\"p\",\"cancelled\"))])"; d1 $TR; disp; }
d_job_vazio() { cen "dict(passos=[dict(runs=[$FALHO])],jobs=[J(\"b\",\"failure\")])"; d1 $TR; disp; }
d_job_timeout() { cen "dict(passos=[dict(runs=[$FALHO]),dict(runs=[$FALHO])],jobs=[J(\"a\",\"success\",(\"pass\",\"failure\")),J(\"b\",\"timed_out\",(\"longo\",\"cancelled\"))])"; d1 $TR; disp; }
d_job_nome_na_lista() { cen "dict(passos=[dict(runs=[$FALHO]),dict(runs=[$FALHO])],jobs=[J(\"b\",\"failure\")])"; d1 --transitorios "job b"; disp; }
d_404() { cen "dict(passos=[dict(runs=[$FALHO])],dispatch_erro=\"HTTP 404: Not Found (https://api.github.com/repos/x/y/actions/workflows/deploy.yml/dispatches)\",passo=\"pass\")"; d1 $TR; disp; echo "--- 2a chamada:"; d1 $TR; disp; }
d_403() { cen "dict(passos=[dict(runs=[$FALHO])],dispatch_erro=\"HTTP 403: must have admin rights\",passo=\"pass\")"; d1 $TR; disp; }
d_lista_502() { cen "dict(passos=[dict(runs=[])],lista_erro=\"HTTP 502: Bad Gateway\")"; d1 $TR; disp; }
d_view_502() { cen "dict(passos=[dict(runs=[$FALHO])],view_erro=\"HTTP 502: Bad Gateway\",passo=\"pass\")"; d1 $TR; disp; }
d_view_volta() { cen "dict(passos=[dict(runs=[$FALHO]),dict(runs=[$FALHO]),dict(runs=[$FALHO]),dict(runs=[$FALHO]),dict(runs=[$FALHO,R(2,X,e=\"workflow_dispatch\",t=\"2026-01-02T00:00:00Z\")])],view_erro=\"HTTP 502: Bad Gateway\",view_erro_n=2,passo=\"pass\")"; dep --commit "$X" --workflow deploy.yml --intervalo 0 --teto 20 --sem-run 5 $TR; disp; }
d_wf1() { cen "dict(passos=[dict(runs=[])],lista_erro=\"could not find any workflows named deploy.yml\")"; d1; disp; }
d_wf2() { cen "dict(passos=[dict(runs=[])],lista_erro=\"HTTP 404: workflow deploy.yml not found on the default branch\")"; d1; disp; }
d_wf3() { cen "dict(passos=[dict(runs=[])],lista_erro=\"HTTP 404: Not Found (https://api.github.com/repos/x/y/actions/workflows/deploy.yml)\")"; d1; disp; }
d_wf4() { cen "dict(passos=[dict(runs=[])],lista_erro=\"failed to get run: HTTP 503: workflow service not found upstream\")"; d1; disp; }
d_auth() { cen "dict(passos=[dict(runs=[])],lista_erro=\"HTTP 401: Bad credentials\")"; d1; disp; }
d_view_lixo() { cen "dict(passos=[dict(runs=[$FALHO])],view_bruto=\"<html>\")"; d1 $TR; disp; }
d_passo_none() { cen "dict(passos=[dict(runs=[$FALHO])],jobs=[dict(name=\"a\",conclusion=\"failure\",steps=[dict(conclusion=\"failure\")])])"; d1 $TR; disp; }
d_verde() { cen "dict(passos=[dict(runs=[R(1,X)])])"; d1; disp; }
d_sem_sha() { cen "dict(passos=[dict(runs=[dict(databaseId=1,headBranch=\"main\",status=\"completed\",conclusion=\"success\",createdAt=\"2026-01-01T00:00:00Z\",event=\"push\")])],sem_filtro=True)"; d1; disp; }
for c in d_todos d_um_real d_job_sem d_job_vazio d_job_timeout d_job_nome_na_lista d_404 d_403 d_lista_502 d_view_502 d_view_volta d_wf1 d_wf2 d_wf3 d_wf4 d_auth d_view_lixo d_passo_none d_verde d_sem_sha; do caso $c $c; done

