#!/bin/bash
S="$1"; A="$S/at6/arq"; I="$A/.agents/skills/sdd-iniciar-repo/scripts/inventario.sh"; C="$A/.agents/skills/sdd-checar-ambiente/scripts/checar.sh"
W="$(mktemp -d "$S/at4/w.XXXX")"; P="$W/proj"; mkdir -p "$P"; echo oi > "$P/a.txt"
mkdir -p "$W/ok" "$W/des" "$W/lento" "$W/rede"
printf '#!/bin/sh\nexit 0\n' > "$W/ok/gh"
printf '#!/bin/sh\necho "You are not logged into any GitHub hosts." >&2; exit 1\n' > "$W/des/gh"
printf '#!/bin/sh\nsleep 30\n' > "$W/lento/gh"
printf '#!/bin/sh\necho "error connecting to api.github.com" >&2; exit 1\n' > "$W/rede/gh"
chmod +x "$W"/*/gh
for c in "ausente:/usr/bin:/bin" "ok:$W/ok:/usr/bin:/bin" "deslogado:$W/des:/usr/bin:/bin" "lento:$W/lento:/usr/bin:/bin" "rede:$W/rede:/usr/bin:/bin"; do
  n="${c%%:*}"; p="${c#*:}"; t0=$SECONDS
  out="$(cd "$P" && env PATH="$p" bash "$I" 2>&1)"; rc=$?
  echo "--- caso $n: rc=$rc, $((SECONDS-t0)) s, linhas gh: $(printf '%s\n' "$out" | grep -c '^gh:') → $(printf '%s\n' "$out" | grep '^gh:')"
done
echo "--- bloco gh igual nas 2 cópias?"
x() { sed -n '/^# ── gh e instalação/,/^# ── fim do gh/p' "$1"; }
diff <(x "$C") <(x "$I") && echo "IGUAIS ($(x "$C" | wc -l | tr -d ' ') linhas)"
