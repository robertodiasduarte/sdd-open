$ git diff 36d0454 HEAD -- .github/workflows/release.yml .github/workflows/publish-gate.yml | grep -E "^[-+]" | grep -v "^+++\|^---"
+
+  # F16: o caso real do aluno no Windows é o Git Bash com o Python nativo (o WSL é Linux por dentro, e o
+  # Ubuntu acima já o cobre). Informativo até o Roberto decidir o piso: fica FORA do `needs:` do job
+  # `release`, então um vermelho aqui aparece no run sem segurar a Release (sem continue-on-error).
+  testes-windows:
+    name: Testes no Windows (Git Bash + Python nativo, só leitura)
+    runs-on: windows-latest
+    # F16: a 1ª medição (PR #25, commit 416c0d5) rodou a suíte inteira e foi cancelada nos 90 min com 15% feito
+    # (~19 s por teste, 156 quebras em 282). Aqui fica só o caminho do aluno; o porte da suíte é a frente F16W.
+    timeout-minutes: 30
+    defaults:
+      run:
+        shell: bash
+    steps:
+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
+        with:
+          fetch-depth: 0
+
+      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
+        with:
+          python-version: '3.12'
+
+      - name: Install gitleaks (windows)
+        run: |
+          mkdir -p "$RUNNER_TEMP/bin"
+          curl -fsSL -o "$RUNNER_TEMP/gitleaks.zip" \
+            https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_windows_x64.zip
+          python -m zipfile -e "$RUNNER_TEMP/gitleaks.zip" "$RUNNER_TEMP/bin"
+          "$RUNNER_TEMP/bin/gitleaks.exe" version
+          echo "$RUNNER_TEMP/bin" >> "$GITHUB_PATH"
+
+      # Afirmado, não só impresso: o Python é o nativo (os.name == nt) e o bash dos testes é o do Git,
+      # nunca o bash.exe do WSL que o PATH do Windows pode achar antes.
+      - name: Git Bash and native Python (asserted)
+        run: |
+          command -v bash
+          bash -c 'echo "bash $BASH_VERSION"; uname -s; case "$(uname -s)" in MINGW*|MSYS*) ;; *) exit 1 ;; esac'
+          python -c 'import os, sys; print(sys.version, os.name); sys.exit(os.name != "nt")'
+          echo "SDD_TEST_BASH=$(cygpath -w "$(command -v bash)")" >> "$GITHUB_ENV"
+
+      - name: Run publish gate
+        env:
+          PUBLISH_GATE_MODE: ci
+        run: bash scripts/publish-gate.sh "$(pwd)"
+
+      # Só o caminho do aluno no Windows: checar-ambiente, inventário do iniciar-repo, resolvedor de Python,
+      # pulos por recurso e textos da F16. -v e sem buffer: o nome de cada teste sai na hora, mesmo se o teto cortar.
+      - name: Unit tests, student path (Git Bash + native Python)
+        working-directory: tests
+        env:
+          PYTHONUNBUFFERED: '1'
+        run: python -B -m unittest -v test_checar test_inventario test_python_resolver test_windows test_f16_textos
+  # F16: o caso real do aluno no Windows é o Git Bash com o Python nativo (o WSL é Linux por dentro, e o
+  # Ubuntu acima já o cobre). Informativo até o Roberto decidir o piso: fica FORA do `needs:` do job
