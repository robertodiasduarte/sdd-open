    | # Roda um script cujo os.path.join é o ntpath.join (como o Python nativo do Windows), só nas chamadas do próprio
    | # script (a stdlib segue posix), num sistema de arquivos que aceita "\\" e "/" (como o Windows).
    | # uso: winpath_run.py <script> [args]
    | import builtins, ntpath, os, posixpath, runpy, sys
    | ALVO = None; _PJ = posixpath.join
    | import argparse, collections, datetime, re, subprocess, unicodedata, json, shlex, fnmatch, hashlib  # antes do remendo
    | f = lambda p: p.replace("\\", "/") if isinstance(p, str) else p
    | def join(*a):
    |     return (ntpath.join if sys._getframe(1).f_code.co_filename == ALVO else _PJ)(*a)
    | os.path.join = join
    | for nome in ("isdir", "isfile", "exists", "islink", "getmtime"):
    |     orig = getattr(os.path, nome); setattr(os.path, nome, (lambda o: lambda p, *a, **k: o(f(p), *a, **k))(orig))
    | for nome in ("listdir", "stat", "lstat"):
    |     orig = getattr(os, nome); setattr(os, nome, (lambda o: lambda p=".", *a, **k: o(f(p), *a, **k))(orig))
    | _open = builtins.open; builtins.open = lambda p, *a, **k: _open(f(p), *a, **k)
    | ALVO = sys.argv[1]
    | sys.argv = sys.argv[1:]; runpy.run_path(sys.argv[0], run_name="__main__")
