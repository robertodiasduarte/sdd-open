$ P=$PWD; T=$(mktemp -d); cd "$T" && git init -q -b main r && cd r
mkdir -p sdd/bin sdd/baselines && cp "$P"/sdd/bin/test-baseline.sh sdd/bin/
deno --version | head -1
printf "Deno.test(\"soma\", () => {});\nDeno.test(\"conhecido\", () => { throw new Error(\"x\"); });\nDeno.test(\"novo\", () => { throw new Error(\"y\"); });\n" > conta_test.ts
printf "conta_test.ts::conhecido\n" > sdd/baselines/tests.txt
echo "== deno test (cor padrão)"; bash sdd/bin/test-baseline.sh --cmd "deno test --no-check conta_test.ts"; echo "exit=$?"
echo "== NO_COLOR=1 deno test"; bash sdd/bin/test-baseline.sh --cmd "NO_COLOR=1 deno test --no-check conta_test.ts"; echo "exit=$?"
echo "== bytes da linha => (cor padrão):"; deno test --no-check conta_test.ts 2>&1 | grep -a "=> " | head -2 | od -c | head -6
cd /; rm -rf "${T:?}"
