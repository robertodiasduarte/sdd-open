$ P=$PWD; T=$(mktemp -d); cd "$T" && git init -q -b main r && cd r
mkdir -p sdd/bin sdd/baselines fx && cp "$P"/sdd/bin/test-baseline.sh sdd/bin/
cfg() { printf "project:\n  test_cmd: \"%s\"\n" "$1" > sdd/config.yaml; }
echo "##### A) go: pacote que estourou o -timeout (sem linha --- FAIL) + 1 falha conhecida, execução completa"
printf "TestConhecido\nTestLento\n" > sdd/baselines/tests.txt
printf -- "--- FAIL: TestConhecido (0.00s)\n    conta_test.go:10: esperado 2\nFAIL\nFAIL\texemplo/conta\t0.005s\npanic: test timed out after 1s\nrunning tests:\n\tTestLento (1s)\n\ngoroutine 6 [running]:\ntesting.(*M).startAlarm.func1()\nFAIL\texemplo/lento\t1.012s\nFAIL\n" > fx/go-timeout.txt
cat fx/go-timeout.txt; echo "-----"
cfg "cat fx/go-timeout.txt; exit 1"; bash sdd/bin/test-baseline.sh; echo "exit=$?"; echo "baseline depois:"; cat sdd/baselines/tests.txt
echo "##### B) deno real: 1 falha conhecida + erro não capturado noutro arquivo"
printf "Deno.test(\"conhecido\", () => { throw new Error(\"x\"); });\n" > a_test.ts
printf "Deno.test(\"ok\", () => {}); setTimeout(() => { throw new Error(\"solto\"); }, 0);\n" > b_test.ts
printf "a_test.ts::conhecido\n" > sdd/baselines/tests.txt
cfg "deno test --no-check a_test.ts b_test.ts"; bash sdd/bin/test-baseline.sh; echo "exit=$?"
echo "--- saída crua do deno:"; deno test --no-check a_test.ts b_test.ts 2>&1 | sed -n "1,40p"
cd /; rm -rf "${T:?}"
