T=$(mktemp -d)
caso() { printf "%s\n" "$2" > "$T/$1.log"; bash sdd/bin/gate-shell-evidencia.sh "$T/$1.log" >"$T/o" 2>&1; r=$?; echo "-- $1 => exit=$r $(grep "^🛑 /" "$T/o" | sed "s#$T/##" | cut -c1-90)"; }
caso sort-com-var "\$ cmd | LC_ALL=C sort
[exit=0]"
