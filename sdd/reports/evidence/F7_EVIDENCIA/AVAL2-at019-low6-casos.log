[exit=1]"
caso rc-depois "\$ cmd | tail -1; rc=\$?; echo \"[exit=\$rc]\"
[exit=0]"
caso literal "\$ cmd
[exit=\$?]"
caso grep-c "\$ cmd | grep -c X
[exit=0]"
caso jq-e "\$ cmd | jq -e .a
[exit=0]"
caso awk-exit "\$ cmd | awk \x27/x/{f=1} END{exit !f}\x27
[exit=0]"
caso ou-ou "\$ cmd || echo falhou
[exit=0]"
caso caminho-abs "\$ cmd | /usr/bin/tail -1
[exit=0]"
caso dois-vars "\$ cmd | A=1 B=2 wc -l
[exit=0]"
caso pipefail "\$ set -o pipefail; cmd | tail -1
[exit=0]"
caso exit-N-sem-colchete "\$ cmd | head -3
exit=0"
caso multilinha-bypass "\$ 
cmd | tail -1
[exit=0]"
caso comentario-pipestatus "\$ cmd | tail -1 # PIPESTATUS
[exit=0]"
caso subshell-tail "\$ cmd | (tail -1)
[exit=0]"
caso command-tail "\$ cmd | command tail -1
[exit=0]"
rm -rf "${T:?}"
