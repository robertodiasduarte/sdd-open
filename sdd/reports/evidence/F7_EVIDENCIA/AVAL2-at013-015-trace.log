$ P=$PWD; T=$(mktemp -d); cd "$T" && git init -q r && cd r && mkdir -p sdd/bin sdd/fixtures && cp "$P"/sdd/bin/verify-gate.sh sdd/bin/ && cp "$P"/sdd/fixtures/DEFINE_FIXTURE_*.md sdd/fixtures/
mk() { printf "## Verify Gate\n\n\`\`\`yaml\nverify_gate:\n  kind: %s\n  cmd: \"%s\"\n  pass_when: \"exit 0\"\n\`\`\`\n" "$2" "$3" > sdd/fixtures/DEFINE_$1.md; }
mk V test "true"; mk R test "exit 1"; mk I test "nao_existe_cmd_xyz"; mk M manual-ux "N/A (manual-ux)"
for f in V R I M FIXTURE_CONTROLE FIXTURE_NEEDS_CLARIFICATION FIXTURE_SEM_BLOCO; do bash sdd/bin/verify-gate.sh sdd/fixtures/DEFINE_$f.md >/dev/null 2>&1; echo "$f exit=$?"; done
bash sdd/bin/verify-gate.sh --strict sdd/fixtures/DEFINE_I.md >/dev/null 2>&1; echo "I --strict exit=$?"
bash sdd/bin/verify-gate.sh --strict sdd/fixtures/DEFINE_M.md >/dev/null 2>&1; echo "M --strict exit=$?"
bash sdd/bin/verify-gate.sh --print sdd/fixtures/DEFINE_V.md >/dev/null 2>&1; echo "V --print exit=$?"
SDD_TRACE=off bash sdd/bin/verify-gate.sh sdd/fixtures/DEFINE_V.md >/dev/null 2>&1; echo "V off exit=$?"
echo "--- traces:"; for f in sdd/traces/*.jsonl; do echo "## $f ($(wc -l <"$f" | tr -d " ") linhas)"; cat "$f"; done
echo "--- sem-define:"; bash sdd/bin/verify-gate.sh --sem-define F9_X; echo "exit=$?"; cat sdd/traces/F9_X.jsonl
bash sdd/bin/verify-gate.sh --sem-define; echo "sem F exit=$?"
echo "--- sem-define com trace 444:"; chmod 444 sdd/traces/F9_X.jsonl; bash sdd/bin/verify-gate.sh --sem-define F9_X; echo "exit=$?"; wc -l < sdd/traces/F9_X.jsonl
echo "--- subdir: rodando de sdd/fixtures"; cd sdd/fixtures && bash ../bin/verify-gate.sh DEFINE_V.md >/dev/null 2>&1; echo "exit=$?"; cd ../..; ls sdd/fixtures/sdd 2>&1 | head -1; cat sdd/traces/V.jsonl
cd /; chmod -R u+w "$T"; rm -rf "${T:?}"
V exit=0
R exit=2
I exit=3
M exit=4
FIXTURE_CONTROLE exit=0
FIXTURE_NEEDS_CLARIFICATION exit=5
FIXTURE_SEM_BLOCO exit=64
I --strict exit=1
M --strict exit=1
V --print exit=0
V off exit=0
