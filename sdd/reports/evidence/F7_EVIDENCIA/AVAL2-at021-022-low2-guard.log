echo "== LOW-2 renomeação staged"; git mv sdd/bin/x.sh sdd/bin/y.sh; G $PERM
CMDSUG=$(bash sdd/bin/avaliador-guard.sh $PERM | sed -n "s/^→ //p"); echo "$CMDSUG"; /bin/bash -c "$CMDSUG" >/dev/null; echo "rc do comando sugerido=$?"; G $PERM
echo "== renomeação com edição não staged do destino"; git mv sdd/bin/y.sh sdd/bin/z.sh; echo z2 > sdd/bin/z.sh; CMDSUG=$(bash sdd/bin/avaliador-guard.sh $PERM | sed -n "s/^→ //p"); echo "$CMDSUG"; /bin/bash -c "$CMDSUG" >/dev/null; echo "rc=$?"; G $PERM
echo "== achado: só uma remoção STAGED (git rm) — o comando sugerido vira add -A sem caminho"
git rm -q sdd/bin/apagar.sh; G $PERM
CMDSUG=$(bash sdd/bin/avaliador-guard.sh $PERM | sed -n "s/^→ //p"); echo "$CMDSUG"; /bin/bash -c "$CMDSUG" >/dev/null; echo "rc=$?"
echo "-- arquivos que entraram no commit sugerido:"; git show --name-status --format= HEAD
echo "== AT-022 git falha"; G --root /
echo "== off"; SDD_AVALIADOR_GUARD=off bash sdd/bin/avaliador-guard.sh; echo "exit=$?"
echo "== uso"; G --bogus
cd /; rm -rf "${T:?}"
