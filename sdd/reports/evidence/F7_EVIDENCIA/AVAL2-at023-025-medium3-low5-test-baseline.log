$ P=$PWD; T=$(mktemp -d); cd "$T" && git init -q -b main r && cd r && git config user.email a@b.c && git config user.name t
mkdir -p sdd/bin sdd/baselines fx && cp "$P"/sdd/bin/test-baseline.sh sdd/bin/ && cp "$P"/sdd/fixtures/evidencia/testes-*.txt fx/
TB() { bash sdd/bin/test-baseline.sh "$@"; echo "exit=$?"; }
cfg() { printf "project:\n  test_cmd: \"%s\"\n" "$1" > sdd/config.yaml; }
echo "##### AT-023: 1 conhecida + 1 nova por formato (--cmd)"
for f in unittest pytest jest vitest go deno; do
  case $f in unittest) K="test_conta.Caso.test_conhecido";; pytest) K="tests/test_conta.py::test_conhecido";; jest) K="Conta › conhecido";; vitest) K="src/conta.test.ts > Conta > conhecido";; go) K=TestConhecido;; deno) K="conta_test.ts::conhecido";; esac
  printf "%s\n" "$K" > sdd/baselines/tests.txt
  echo "=== $f (baseline: $K)"; bash sdd/bin/test-baseline.sh --cmd "cat fx/testes-$f.txt; exit 1" | grep -E "nova|conhecida|RESULTADO"; echo "exit=${PIPESTATUS[0]}"
  # só a conhecida: remove a linha da nova da saída
  grep -v -iE "novo|test_novo" fx/testes-$f.txt > fx/so-$f.txt
  bash sdd/bin/test-baseline.sh --cmd "cat fx/so-$f.txt; exit 1" | grep -E "nova|conhecida|RESULTADO"; echo "  só conhecida exit=${PIPESTATUS[0]}"
done
echo "##### MEDIUM-3: go [build failed] + conhecida, execução completa"
printf "TestConhecido\nTestSarou\n" > sdd/baselines/tests.txt; cp sdd/baselines/tests.txt /tmp/../$T/antes.txt
printf -- "--- FAIL: TestConhecido (0.00s)\nFAIL\texemplo/conta\t0.005s\nFAIL\texemplo/outro [build failed]\nFAIL\n" > fx/go-build.txt
cfg "cat fx/go-build.txt; exit 1"; TB; cmp -s "$T/antes.txt" sdd/baselines/tests.txt && echo "baseline byte-idêntico" || { echo "BASELINE MUDOU:"; cat sdd/baselines/tests.txt; }
printf -- "--- FAIL: TestConhecido (0.00s)\nFAIL\texemplo/conta\t0.005s\nFAIL\texemplo/outro [setup failed]\n" > fx/go-setup.txt
cfg "cat fx/go-setup.txt; exit 1"; TB; cmp -s "$T/antes.txt" sdd/baselines/tests.txt && echo "baseline byte-idêntico" || echo BASELINE MUDOU
echo "##### AT-024: execução completa sem falha nova poda e lista"
cfg "cat fx/so-go.txt; exit 1"; TB; echo "baseline agora:"; cat sdd/baselines/tests.txt
echo "##### AT-024: --cmd não poda"
printf "TestConhecido\nTestSarou\n" > sdd/baselines/tests.txt; cp sdd/baselines/tests.txt antes2.txt
TB --cmd "cat fx/so-go.txt; exit 1"; cmp -s antes2.txt sdd/baselines/tests.txt && echo "byte-idêntico"
echo "##### AT-024: resultado 2 (nova) em execução completa não poda"
cfg "cat fx/testes-go.txt; exit 1"; TB; cmp -s antes2.txt sdd/baselines/tests.txt && echo "byte-idêntico"
echo "##### AT-024/LOW-5: --aceitar não roda o test_cmd (test_cmd grava marcador e imprime nada)"
cfg "touch RODOU; exit 1"; rm -f RODOU; TB --aceitar "TestNovo"; [ -e RODOU ] && echo "RODOU o test_cmd (ERRO)" || echo "test_cmd NÃO rodou"; cat sdd/baselines/tests.txt; TB --aceitar "TestNovo"
echo "##### AT-024: --touched"
git add -A && git commit -qm base && git update-ref refs/remotes/origin/main HEAD
printf "TestConhecido\n" > sdd/baselines/tests.txt; cp sdd/baselines/tests.txt antes3.txt
mkdir -p pkg && echo x > pkg/conta_test.go
printf -- "--- FAIL: TestConhecido (0.00s)\n--- FAIL: TestNovo (0.00s)\n    conta_test.go:15: x\n" > fx/go-touch.txt
cfg "cat fx/go-touch.txt; exit 1"; TB --touched; cmp -s antes3.txt sdd/baselines/tests.txt && echo "byte-idêntico"
printf "FAILED tests/test_a.py::test_x - e\nFAILED tests/test_b.py::test_y - e\n" > fx/py-touch.txt; mkdir -p tests; echo x > tests/test_a.py
cfg "cat fx/py-touch.txt; exit 1"; TB --touched
TB --touched --base nao/existe
echo "##### AT-025"
cfg "echo boom; exit 1"; TB
cfg "comando_que_nao_existe_xyz"; TB
cfg ""; TB
rm sdd/config.yaml; TB
TB --cmd
cd /; rm -rf "${T:?}"
