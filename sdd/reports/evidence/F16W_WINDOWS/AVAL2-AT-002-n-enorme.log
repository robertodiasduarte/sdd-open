import subprocess, sys
for n in ("1/1000000", "1/100000000000"):
    try:
        r = subprocess.run([sys.executable, "-B", "scripts/testes-por-modulo.py", "--lista", "--fatia", n], capture_output=True, encoding="utf-8", timeout=30)
        print(n, "rc=%d" % r.returncode, "linhas=%d" % len(r.stdout.split()), "| stderr:", r.stderr.strip().splitlines()[-1:] )
    except subprocess.TimeoutExpired:
        print(n, "passou de 30 s")

