$ S=sdd/bin/contraste.sh; t(){ printf "\n--- %s\n" "$*"; "$@"; echo "[rc=$?]"; }
t bash $S "#767676" "#ffffff"
t bash $S "#777777" "#ffffff"
t bash $S "#71796f" "#ffffff"
t bash $S "#6c7b67" "#ffffff"
t bash $S "#000" "#fff" .5
t bash $S "#000" "#fff" 1
t bash $S "#000" "#fff" 0
t bash $S "#777777" "#ffffff" --piso 3
t bash $S --piso 3 "#777777" "#ffffff"
t bash $S "#777777" --piso 3 "#ffffff"
t bash $S "rgba(0,0,0,.5)" "#fff"
t bash $S "#zzz" "#fff"
t bash $S "#12345" "#fff"
t bash $S "#000" "#fff" --piso 4.555
t bash $S "#000" "#fff" --piso 0
echo "=== locale"
LC_ALL=pt_BR.UTF-8 awk "BEGIN{printf \"%.1f\n\", .5}"
LC_ALL=pt_BR.UTF-8 LC_NUMERIC=pt_BR.UTF-8 LANG=pt_BR.UTF-8 bash $S "#000" "#fff" .5; echo "[rc=$?]"
LC_ALL=pt_BR.UTF-8 bash $S "#767676" "#ffffff" --piso 4.5; echo "[rc=$?]"
LC_ALL=pt_BR.UTF-8 bash $S --self-test; echo "[rc=$?]"
echo "=== CDPATH"
CDPATH=. bash $S --self-test 2>&1; echo "[rc=$?]"
CDPATH=. bash $S "#000" "#fff"; echo "[rc=$?]"
echo "=== drift CDPATH"
CDPATH=. bash sdd/bin/prompt-drift-scan.sh --self-test 2>&1; echo "[rc=$?]"


