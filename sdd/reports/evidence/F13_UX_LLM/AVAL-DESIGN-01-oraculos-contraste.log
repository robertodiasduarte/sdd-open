$ T=$(mktemp -d); cat > $T/o.py <<"PY"
def lin(c):
    c/=255.0
    return c/12.92 if c<=0.04045 else ((c+0.055)/1.055)**2.4
def rgb(h):
    h=h[1:]
    if len(h)==3: h="".join(x*2 for x in h)
    return [int(h[i:i+2],16) for i in (0,2,4)]
def ratio(f,b,a=1.0):
    F,B=rgb(f),rgb(b)
    F=[a*x+(1-a)*y for x,y in zip(F,B)]
    L=lambda v:0.2126*lin(v[0])+0.7152*lin(v[1])+0.0722*lin(v[2])
    l1,l2=L(F),L(B)
    if l1<l2:l1,l2=l2,l1
    return (l1+.05)/(l2+.05)
for p in [("#767676","#ffffff",1),("#777777","#ffffff",1),("#71796f","#ffffff",1),("#6c7b67","#ffffff",1),("#000","#fff",.5),("#000","#fff",1),("#000","#fff",0)]:
    print(p, "%.7f"%ratio(*p))
PY
/usr/bin/python3 -B $T/o.py; cat > $T/c.awk <<"AWK"
function lin(c){ c/=255; return c<=0.04045 ? c/12.92 : ((c+0.055)/1.055)^2.4 }
BEGIN{ f[0]=a*fr+(1-a)*br; f[1]=a*fg+(1-a)*bg; f[2]=a*fb+(1-a)*bb
 L1=0.2126*lin(f[0])+0.7152*lin(f[1])+0.0722*lin(f[2]); L2=0.2126*lin(br)+0.7152*lin(bg)+0.0722*lin(bb)
 if(L1<L2){t=L1;L1=L2;L2=t}; print int((L1+0.05)/(L2+0.05)*100+1e-9) }
AWK
for args in "118 118 118 255 255 255 1" "119 119 119 255 255 255 1" "113 121 111 255 255 255 1" "108 123 103 255 255 255 1" "0 0 0 255 255 255 .5" "0 0 0 255 255 255 1" "0 0 0 255 255 255 0"; do set -- $args; printf "%s => " "$args"; LC_ALL=C /usr/bin/awk -v fr=$1 -v fg=$2 -v fb=$3 -v br=$4 -v bg=$5 -v bb=$6 -v a=$7 -f $T/c.awk; done; rm -rf "$T"
