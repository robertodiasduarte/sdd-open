$ S=/Users/robertoduarte/rdd-worktrees/sdd-open-f13-ux-llm/sdd/bin/prompt-drift-scan.sh; T=$(mktemp -d); trap "chmod -R u+rwx $T; rm -rf $T" EXIT; P=$T/proj; mkdir -p $P/sdd $P/src $P/prompts $P/Prompts2; cd $P; export GIT_CEILING_DIRECTORIES=$T
printf "prompts:\n  wrapper_pattern: \"systemPrompt:|callLLM\\\\\\\\(\"\n" > sdd/config.yaml; cat sdd/config.yaml
s(){ printf "\n--- [%s] %s | scan %s\n" "$1" "$2" "${*:3}"; printf "%b" "$2" | bash $S "${@:3}" 2>&1; echo "[rc=$?]"; }
echo "=== A. --conteudo em diretorio (AT-013: a directory)"
s dir "soma = 1\n" --conteudo src
s dir-prompts "soma = 1\n" --conteudo prompts
s raiz "soma = 1\n" --conteudo /
s ponto "soma = 1\n" --conteudo .
s barra "soma = 1\n" --conteudo src/
s dir-inexistente-barra "soma = 1\n" --conteudo novo/
echo "=== B. sinais falsos negativos"
s espaco-antes-dois-pontos "\"system\" : \"You are\"\n" --conteudo src/a.py
s kw-python "ask(system=\"You are\")\n" --conteudo src/a.py
s role-system "{ role: \"system\", content: \"You are\" }\n" --conteudo src/a.ts
s fstring "ask(system: f\"You are {x}\")\n" --conteudo src/a.py
s fstring-wrap "ask(systemPrompt: f\"You are {x}\")\n" --conteudo src/a.py
s triple "system: \"\"\"You\n" --conteudo src/a.py
s maiuscula "SYSTEM: \"You\"\n" --conteudo src/a.py
s yaml-blk "system: |\n  You are\n" --conteudo src/a.yml
s responses "client.responses.create(input=x)\n" --conteudo src/a.py
s gemini "model.generateContent(x)\n" --conteudo src/a.py
s stream "client.messages.stream(x)\n" --conteudo src/a.py
echo "=== C. caminhos"
s dir-maiusc "x\n" --conteudo src/Prompts/a.txt
s test-em-prompts "x\n" --conteudo src/prompts/test_plan.txt
s spec-em-prompts "x\n" --conteudo prompts/a.spec.txt
s test-sdk "client.messages.create(x)\n" --conteudo src/test_generator.py
s spec-rb "client.messages.create(x)\n" --conteudo spec/a_spec.rb
s javatest "client.messages.create(x)\n" --conteudo src/FooTest.java
s mdx "x\n" --conteudo docs/a.mdx
s MD-sdk "client.messages.create(x)\n" --conteudo docs/a.MD
s ponto-barra "x\n" --conteudo ./prompts/a.txt
s dupla-barra "x\n" --conteudo src//prompts//a.txt
s dotdot-existente "x\n" --conteudo src/../prompts/a.txt
s dotdot-inexistente "x\n" --conteudo src/novo/../a.txt
s dotdot-escapa "client.messages.create(x)\n" --conteudo ../../a.ts
s traco "x\n" --conteudo -a.ts
s vazio "x\n" --conteudo ""
s espaco "x\n" --conteudo "src/com espaco/prompts/a b.txt"
ln -s ../prompts/a.txt src/link.txt; printf "benigno\n" > prompts/a.txt
echo "=== D. symlink de arquivo para prompts/ em disco"
bash $S src/link.txt 2>&1; echo "[rc=$?]"
ln -s $P $T/atalho; (cd $T; bash $S atalho/prompts/a.txt 2>&1; echo "[rc=$?] via atalho (cwd fora)"; printf "x\n" | bash $S --conteudo $T/atalho/src/tests/a.py 2>&1; echo "[rc=$?]")
echo "=== E. disco"
: > src/vazio.ts; bash $S src/vazio.ts 2>&1; echo "[rc=$?] vazio"
mkfifo src/f; bash $S src/f 2>&1 </dev/null; echo "[rc=$?] fifo"
printf "client.messages.create\0x\n" > src/bin.dat; bash $S src/bin.dat 2>&1; echo "[rc=$?] binario com sinal"
printf "\xff\xfe client.chat.completions.create(x)\n" > src/l1.py; bash $S src/l1.py 2>&1; echo "[rc=$?] nao-utf8"
printf "client.messages.create(x)\n" > src/a.ts; printf "ok\n" > src/b.ts; bash $S src/b.ts src/a.ts prompts/a.txt 2>&1; echo "[rc=$?] varios"
bash $S src/b.ts nao.ts 2>&1; echo "[rc=$?] um inexistente"
bash $S src/a.ts --conteudo 2>&1; echo "[rc=$?] conteudo pos 2"
printf "\n" | bash $S --conteudo src/x.ts 2>&1; echo "[rc=$?] so newline"
bash $S --conteudo src/x.ts <&- 2>&1; echo "[rc=$?] stdin fechado"

