for k in ["intent","control_state","cycle_protocol","context_assembly","action_space","observation","verifier","recovery_and_convergence_policy","stop_rules","budget","observability"]: ok("exemplo standard <%s>"%k,"<%s>"%k in ex and "</%s>"%k in ex)
ok("exemplo LLM e codigo","| LLM |" in ex and "| código |" in ex)
PY
