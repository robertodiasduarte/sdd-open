import re,subprocess,tempfile,os,shutil,unicodedata
root=os.getcwd()
T=tempfile.mkdtemp()
frag=open("sdd/templates/fragments/LLM_PROMPTS_DESIGN.md",encoding="utf-8").read()
tmpl=open("sdd/templates/DESIGN_TEMPLATE.md",encoding="utf-8").read()
frag=frag[frag.index("## LLM Prompts"):]
base="""# DESIGN

## Key Decisions

### Decision 1: x

## File Manifest

| # | File | Action | Purpose | Dependencies |
|---|---|---|---|---|
| 1 | a.py | Create | a | None |

**Total Files:** 1

"""
def fill(s):
    s=re.sub(r"\{[^{}\n]*\}","v",s)
    return s
ok=fill(frag)
def run(name,doc):
    p=os.path.join(T,"D.md"); open(p,"w",encoding="utf-8").write(doc)
    r=subprocess.run(["/usr/bin/python3","-B","sdd/bin/design-lint.py",p],capture_output=True,text=True)
    print("--- %s\n    rc=%d"%(name,r.returncode))
    out=(r.stdout+r.stderr).replace(p,"D.md").strip().split("\n")
    for l in out[:9]: print("    "+l)
run("sem secao",base)
run("fragmento preenchido",base+ok)
run("fragmento NAO preenchido",base+frag)
run("titulo com sufixo: ## LLM Prompts (v1) com inventario antigo",base+"## LLM Prompts (v1)\n\n### Inventory\n\n| a |\n|---|\n| 1 |\n")
run("titulo ## LLM Prompts: 1",base+"## LLM Prompts: 1\n\n### Inventory\n")
run("titulo ### LLM Prompts",base+"### LLM Prompts\n\n### Inventory\n")
run("titulo ## Prompts LLM",base+"## Prompts LLM\n\n### Inventory\n")
run("titulo com espaco final",base+"## LLM Prompts   \n\n### Inventory\n")
run("titulo ##  LLM Prompts (2 espacos)",base+"##  LLM Prompts\n\n### Inventory\n")
run("N/A na secao",base+"## LLM Prompts\n\nN/A\n")
run("Inventario sem acento",base+ok.replace("### Inventário","### Inventario"))
run("Inventario NFD",base+unicodedata.normalize("NFD",ok))
run("Inventario em nivel 4",base+ok.replace("### Inventário","#### Inventário"))
run("### Inventário antigo (prefixo)",base+ok.replace("### Inventário","### Inventário antigo"))
run("coluna em negrito",base+ok.replace("| Tipo |","| **Tipo** |",2))
run("coluna em minuscula",base+ok.replace("| Tipo | Arquivo","| tipo | Arquivo"))
run("Tipo negrito",base+ok.replace("| one-shot |","| **one-shot** |",1))
run("Tipo crase",base+ok.replace("| 1 | v | one-shot |","| 1 | v | `loop` |"))
run("Tipo LOOP",base+ok.replace("| 1 | v | one-shot |","| 1 | v | LOOP |"))
run("Tipo vazio",base+ok.replace("| 1 | v | one-shot |","| 1 | v |  |"))
run("linha curta sem coluna Tipo",base+ok.replace("| 1 | v | one-shot | `v` | v | v | v | v | v | v | v |","| 1 | v |"))
loop=ok.replace("| 1 | v | one-shot |","| 1 | v | loop |")
run("loop sem Perfil de risco nem Ground truth (fragmento diz 2 linhas a mais)",base+loop)
run("campo vazio Autonomo",base+ok.replace("| **Autônomo?** | v |","| **Autônomo?** |  |"))
run("campo so traco",base+ok.replace("| **Autônomo?** | v |","| **Autônomo?** | — |"))
run("campo sem negrito",base+ok.replace("| **Autônomo?** | v |","| Autônomo? | v |"))
run("campo em prosa fora da tabela",base+ok.replace("| **Autônomo?** | v |\n","").replace("#### Prompt 1: v\n","#### Prompt 1: v\n\n**Autônomo?** sim\n"))
run("campo faltando",base+ok.replace("| **Eval mínimo pré-ship** | v |\n",""))
run("2 linhas 1 bloco",base+ok.replace("| 1 | v | one-shot |","| 2 | w | loop | `w` | v | v | v | v | v | v | v |\n| 1 | v | one-shot |"))
run("bloco sem dois pontos: #### Prompt 1 v",base+ok.replace("#### Prompt 1: v","#### Prompt 1 v"))
run("bloco Prompt 1 - v",base+ok.replace("#### Prompt 1: v","#### Prompt 1 - v"))
run("bloco antes do Inventario",base+"## LLM Prompts\n\n#### Prompt 1: v\n\n| **Autônomo?** | v |\n| **Verification interna** | v |\n| **Eval mínimo pré-ship** | v |\n\n### Inventário\n\n| Tipo | Versão | Completeness | Refator de? |\n|---|---|---|---|\n| loop | v | v | v |\n")
run("2 secoes: a 2a invalida",base+ok+"\n## LLM Prompts\n\n### Inventory\n")
run("secao dentro de cerca",base+"```\n## LLM Prompts\n\n### Inventory\n```\n")
run("secao em comentario HTML",base+"<!--\n## LLM Prompts\n\n### Inventory\n-->\n")
run("2a tabela em Inventario conta como linhas",base+ok.replace("Em `Tipo=loop`, o arquivo","| z | y |\n|---|---|\n| 1 | 2 |\n\nEm `Tipo=loop`, o arquivo"))
run("pipe em celula antes de Tipo",base+ok.replace("| 1 | v | one-shot |","| 1 | a\\|b | one-shot |"))
run("pipe em crase antes de Tipo",base+ok.replace("| 1 | v | one-shot |","| 1 | `a|b` | one-shot |"))
run("CRLF",base.replace("\n","\r\n")+ok.replace("\n","\r\n"))
run("tabela indentada",base+ok.replace("| 1 | v | one-shot |","  | 1 | v | one-shot |"))
run("erro de prompt + erro de manifest: qual o rumo?",base.replace("**Total Files:** 1","**Total Files:** 9")+"## LLM Prompts\n\n### Inventory\n")
run("Tipo errado num DESIGN novo: mensagem diz formato antigo?",base+ok.replace("| 1 | v | one-shot |","| 1 | v | lop |"))
shutil.rmtree(T)
