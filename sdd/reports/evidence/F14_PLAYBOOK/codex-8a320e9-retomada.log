# sdd/config.yaml — copiado de config.example.yaml pelo `init`. Preencha para o seu projeto.
#
# As skills consultam estes slots ({{TEST_CMD}}, {{DEPLOY_CMD}}, …) em vez de fixar comandos.
# Slot VAZIO significa "pule este passo e diga que pulou" — nunca "adivinhe um comando".
# Parser: chaves simples `chave: valor` e mapas de 1 nível; sem âncoras, sem listas complexas.

project:
  name: meu-projeto
  # Comando de teste, usado por gates `kind: test`.
  test_cmd: ""
  # Checagem de tipos/compilação, usada por gates `kind: typecheck`.
  typecheck_cmd: ""
  # Checagem de sintaxe por tipo de arquivo (fase Release, passo 0a).
  lint_cmd: ""
  # Branch de onde nascem as features. Nunca se trabalha nela diretamente (o pre-commit de sdd/hooks
  # recusa commit direto nela quando ela já tem remoto).
  default_branch: main
  # Teto, em KB, do arquivo de contexto do agente (AGENTS.md, CLAUDE.md, GEMINI.md, .cursorrules) num
  # commit: ele entra inteiro em toda sessão do agente. Acima disso o pre-commit recusa. Vazio = 100.
  context_file_max_kb: 100

# Camadas do seu projeto: nome → glob. É o que diz "esta feature toca 2 camadas" — o gatilho
# do avaliador de contexto fresco. `sql` também diz o que conta como migration (report-lint.py).
# Exemplos: sql: "db/migrations/**" · api: "src/api/**" · ui: "src/ui/**" · infra: "deploy/**"
layers:
  api: ""
  ui: ""
  sql: ""

# Evidência do build (report-lint.py): a partir de quantas camadas de `layers:` tocadas pelo File
# Manifest do DESIGN a avaliação em contexto fresco é obrigatória. Abaixo disso, a linha
# `avaliador: N.A. (<motivo>)` no BUILD_REPORT vale. 1 = avaliador sempre. Inteiro >= 1.
evidence:
  require_avaliacao_layers: 2

deploy:
  # Roda na fase Release, depois da única aprovação humana.
  cmd: ""
  # Detecta o que chegou em produção sem commit correspondente (função publicada pelo console,
  # migration aplicada pelo painel). Vazio = você só deploya via git e esse drift não existe.
  drift_check_cmd: ""

release:
  # Bloqueadores próprios do projeto: começa com regras genéricas, cresce a cada incidente.
  landmines_cmd: ""
  # Opcional, pós-deploy (changelog, comunicado, ledger).
  changelog_hook: ""

review:
  # Revisão adversarial (sdd/bin/adversarial-review.sh; docs/adversarial-review.md): uma engine revisa o
  # diff, OUTRA audita a revisão. As engines moram no registry (1 linha por engine; engine nova = 1 linha).
  registry: sdd/review/registry.tsv
  # Quem revisa e quem audita: ids do registry (claude, codex, gemini, openrouter ou openrouter:<modelo>).
  # Uma lista separada por vírgula é a cadeia: a 1ª é a padrão, as outras entram se a anterior ficar sem
  # cota. Vazio = a skill pergunta. O auditor precisa ser outra engine (igual = exit 67; com uma engine
  # só, rode com --um-engine e a revisão registra "diversidade: nenhuma").
  revisor1: ""
  auditor: ""
  # Pasta das revisões (diff, respostas, META.txt). Precisa estar ignorada pelo git (.gitignore ou
  # .git/info/exclude): o script recusa gravar o diff numa pasta que iria para o repositório.
  output_dir: sdd/reports/reviews
  # Teto, em KB, do contexto SDD (BRAINSTORM, DEFINE, DESIGN, BUILD_REPORT) enviado junto do diff.
  # Acima disso o BRAINSTORM sai primeiro. Inteiro > 0.
  context_max_kb: 180
  # Superfície de segurança do projeto, em globs separados por vírgula (ex.: "auth/**,api/public/**").
  # Uma linha do File Manifest que casa um destes globs torna a revisão do DESIGN obrigatória
  # (sdd/bin/sdd-fluxo.sh review-design) e, num diff que toca um caminho destes, aciona o 2º revisor da
  # revisão adversarial (uma chamada de engine a mais, que pode ser paga). Vazio = só os termos fixos do script (auth, login, token,
  # senha, password, jwt, GRANT, rota pública) e os globs de layers.sql.
  security_globs: ""

# Fluxo encadeado (sdd/templates/fragments/FLUXO_ENCADEADO.md). false = cada fase termina e mostra o
# Próximo passo, como sempre. true = com o gate da fase verde, a fase seguinte começa na mesma sessão,
# as perguntas [auto · de rotina] seguem a opção recomendada e vão para o recibo "Decidi sozinho"; as
# marcadas D1 a D5 continuam perguntadas e a release nunca começa sozinha. Não liga nem desliga o jeito
# de conversar das skills.
flow:
  autonomous: false

# Preenchido pelo sdd-open (`init`): agentes para os quais os adaptadores são gerados.
vendors: ""
# Editor e pasta de worktrees são usados pela skill de nova sessão (sdd-new-session).
editor: ""
worktree_base: ""

# Skill de engenharia de prompt usada pela fase Build quando o DESIGN inventaria prompts de
# producao. Vem preenchida com a skill que acompanha o pacote; troque pelo nome da sua se
# tiver outra. Vazio = a fase Build bloqueia o item de prompt e pede decisao, em vez de
# improvisar o texto que vai para producao.
prompts:
  builder_skill: "sdd-prompt-builder"
  # Se o projeto chama a IA por uma função própria, a expressão do parâmetro dela: o script
  # sdd/bin/prompt-drift-scan.sh procura essa expressão seguida de texto fixo. Exemplos:
  # "systemPrompt:" ou "callLLM\\(" (entre aspas duplas, a contrabarra vai dobrada). Vazio = a
  # varredura vê só os sinais genéricos, e avisa disso.
  wrapper_pattern: ""
