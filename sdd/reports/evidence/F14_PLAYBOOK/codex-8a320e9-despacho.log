    rm -f "${OUT}"
    INCL=""; PERM=""
    for x in "$@"; do
      case "${x}" in *$'\n'*) echo "incluir com quebra de linha: a fronteira não mede" >&2; uso ;; esac
      c="$(canon "${x}")"
      case "${c}" in "${WT}"/*) ;; *) echo "incluir fora do worktree: ${c}" >&2; uso ;; esac
      INCL="${INCL}${c}
"
