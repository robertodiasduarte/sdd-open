bash $BASH_VERSION"; uname -s; case "$(uname -s)" in MINGW*|MSYS*) ;; *) exit 1 ;; esac\'\n          python -c \'import os, sys; print(sys.version, os.name); sys.exit(os.name != "nt")\'\n          echo "SDD_TEST_BASH=$(cygpath -w "$(command -v bash)")" >> "$GITHUB_ENV"\n\n      # O publish-gate não depende da fatia: roda numa só.\n      - name: Run publish gate (on the package assembled by git archive)\n        if: matrix.fatia == 1\n        env:\n          PUBLISH_GATE_MODE: ci\n        run: |\n          P="$(bash scripts/montar-pacote.sh)" || exit 1\n          bash scripts/publish-gate.sh "$P"\n\n      # Uma linha por módulo (estado, testes, falhas, erros, pulados, segundos) e os nomes do que caiu; a saída\n      # inteira de cada módulo vai para o artefato do run.\n      - name: Unit tests by module (slice ${{ matrix.fatia }}/16, Git Bash + native Python)\n        env:\n          PYTHONUNBUFFERED: \'1\'\n          SDD_OPEN_CHECK_UPDATES: \'0\'   # F22: 2ª trava (a 1ª é o tests/apoio.py): a suíte nunca consulta a rede\n        run: python -B scripts/testes-por-modulo.py --fatia "${{ matrix.fatia }}/16" --teto-unidade 600 --saida "$RUNNER_TEMP/tpm"\n\n      - name: Keep the output of each module\n        if: always()\n        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: testes-windows-fatia-${{ matrix.fatia }}\n          path: ${{ runner.temp }}/tpm\n          if-no-files-found: ignore\n          retention-days: 14\n\n'

