## Code Patterns

### Pattern 1: Namespace global e configuração (script clássico)

```javascript
// js/config.js — primeiro script carregado; sem type="module" (file:// bloqueia módulos)
window.Emprestimos = window.Emprestimos || {};
window.Emprestimos.config = Object.freeze({
  chaveArmazenamento: "emprestimos-notebooks-v1",
  notebooks: Object.freeze([
    { id: "nb1", nome: "Notebook 1" },
    { id: "nb2", nome: "Notebook 2" },
    { id: "nb3", nome: "Notebook 3" },
    { id: "nb4", nome: "Notebook 4" },
    { id: "nb5", nome: "Notebook 5" },
    { id: "nb6", nome: "Notebook 6" },
  ]),
});
```

### Pattern 2: Regras puras (recusa, atraso, data local)

```javascript
// js/emprestimos.js — não toca na tela nem no armazenamento
(function (E) {
  function dataLocalISO(d) {            // NÃO usar toISOString(): é UTC e vira "amanhã" à noite no Brasil
    const p = (n) => String(n).padStart(2, "0");
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
  }
  function formatarData(iso) { const [a, m, d] = iso.split("-"); return `${d}/${m}/${a}`; }
  function emprestimoAtivo(dados, notebookId) {
    return dados.emprestimos.find((e) => e.notebookId === notebookId && e.dataVolta === null) || null;
  }
  function registrarSaida(dados, entrada, hoje) {
    const nome = (entrada.funcionario || "").trim();
    if (!E.config.notebooks.some((n) => n.id === entrada.notebookId)) return { ok: false, erro: "Escolha um notebook." };
    if (!nome) return { ok: false, erro: "Informe o nome do funcionário." };
    if (!/^\d{4}-\d{2}-\d{2}$/.test(entrada.dataPrevista || "")) return { ok: false, erro: "Informe a data prevista de volta." };
    const ativo = emprestimoAtivo(dados, entrada.notebookId);
    if (ativo) return { ok: false, erro: `Saída recusada: este notebook já está com ${ativo.funcionario} desde ${formatarData(ativo.dataSaida)}.` };
    const novo = { id: `${entrada.notebookId}-${Date.now()}`, notebookId: entrada.notebookId, funcionario: nome,
                   dataSaida: hoje, dataPrevista: entrada.dataPrevista, dataVolta: null };
    return { ok: true, dados: { ...dados, emprestimos: [...dados.emprestimos, novo] } };
  }
  function estaAtrasado(emp, hoje) { return emp.dataVolta === null && emp.dataPrevista < hoje; } // hoje = ainda no prazo
  E.regras = { dataLocalISO, formatarData, emprestimoAtivo, registrarSaida, estaAtrasado /*, registrarVolta */ };
})(window.Emprestimos);
```

### Pattern 3: Armazenamento com dados ilegíveis e falha ao gravar

```javascript
// js/armazenamento.js
(function (E) {
  const vazio = () => ({ versao: 1, emprestimos: [] });
  function carregar(storage) {
    const chave = E.config.chaveArmazenamento;
    const bruto = storage.getItem(chave);
    if (bruto === null) return { ok: true, dados: vazio() };
    try {
      const dados = JSON.parse(bruto);
      if (dados && dados.versao === 1 && Array.isArray(dados.emprestimos)) return { ok: true, dados };
    } catch (_) { /* segue para a cópia de segurança */ }
    try { storage.setItem(`${chave}-ilegivel-${Date.now()}`, bruto); } catch (e) { console.error("[emprestimos] cópia falhou", e); }
    return { ok: false, dados: vazio(),
             erro: "Os registros salvos estavam ilegíveis. Guardei uma cópia e a lista começou vazia." };
  }
  function salvar(storage, dados) {
    try { storage.setItem(E.config.chaveArmazenamento, JSON.stringify(dados)); return { ok: true }; }
    catch (e) { console.error("[emprestimos] falha ao salvar", e);
                return { ok: false, erro: "Não consegui salvar. Este registro NÃO foi gravado." }; }
  }
  E.armazenamento = { carregar, salvar };
})(window.Emprestimos);
```

### Pattern 4: Gravação na tela (reler antes, nunca innerHTML com texto digitado)

```javascript
// js/tela.js (trecho)
function aoRegistrarSaida(entrada) {
  const atual = E.armazenamento.carregar(localStorage);        // relê: outra aba pode ter mudado os dados
  const hoje = E.regras.dataLocalISO(new Date());
  const r = E.regras.registrarSaida(atual.dados, entrada, hoje);
  if (!r.ok) return mostrarMensagem(r.erro, "erro");
  const s = E.armazenamento.salvar(localStorage, r.dados);
  if (!s.ok) return mostrarMensagem(s.erro, "erro");
  desenhar(r.dados, hoje);
  mostrarMensagem("Saída registrada.", "ok");
}
function celula(texto) { const td = document.createElement("td"); td.textContent = texto; return td; }
// linha atrasada: tr.classList.add("atrasado") quando E.regras.estaAtrasado(emp, hoje)
```

