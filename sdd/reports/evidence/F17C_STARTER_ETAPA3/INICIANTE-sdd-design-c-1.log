## Code Patterns

### Pattern 1: Formato de um empréstimo guardado

```js
// Elemento da lista gravada em localStorage["emprestimos-notebooks:v1"]
{
  id: "Notebook 1-1731600000000",   // notebook + Date.now()
  notebook: "Notebook 1",           // um de Regras.NOTEBOOKS
  funcionario: "Ana",               // texto livre, sem espaços nas pontas, não vazio
  dataSaida: "2026-11-14",          // AAAA-MM-DD, padrão = hoje
  dataPrevista: "2026-11-20",       // AAAA-MM-DD, qualquer data válida
  dataVolta: null                   // null = emprestado; AAAA-MM-DD = devolvido
}
```

### Pattern 2: Regras puras com resultado explícito

```js
// regras.js — carregado com <script src="regras.js"></script> (sem type="module")
window.Regras = (function () {
  const NOTEBOOKS = ["Notebook 1", "Notebook 2", "Notebook 3",
                     "Notebook 4", "Notebook 5", "Notebook 6"];

  function hojeISO(agora = new Date()) {
    const a = agora.getFullYear();
    const m = String(agora.getMonth() + 1).padStart(2, "0");
    const d = String(agora.getDate()).padStart(2, "0");
    return `${a}-${m}-${d}`;
  }

  function dataValida(texto) {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(texto)) return false;
    const [a, m, d] = texto.split("-").map(Number);
    const dt = new Date(a, m - 1, d);
    return dt.getFullYear() === a && dt.getMonth() === m - 1 && dt.getDate() === d;
  }

  function emprestimoAtivo(emprestimos, notebook) {
    return emprestimos.find(e => e.notebook === notebook && e.dataVolta === null) || null;
  }

  function estaAtrasado(emprestimo, hoje) {
    return emprestimo.dataVolta === null && emprestimo.dataPrevista < hoje;
  }

  function registrarSaida(emprestimos, { notebook, funcionario, dataSaida, dataPrevista }) {
    const nome = (funcionario || "").trim();
    if (!NOTEBOOKS.includes(notebook)) return { ok: false, erro: "Escolha um notebook." };
    if (!nome) return { ok: false, erro: "Digite o nome do funcionário." };
    if (!dataValida(dataSaida) || !dataValida(dataPrevista)) {
      return { ok: false, erro: "Informe datas válidas." };
    }
    const ativo = emprestimoAtivo(emprestimos, notebook);
    if (ativo) {
      return { ok: false,
               erro: `O ${notebook} já está com ${ativo.funcionario}, ` +
                     `volta prevista em ${formatarData(ativo.dataPrevista)}.` };
    }
    const novo = { id: `${notebook}-${Date.now()}`, notebook, funcionario: nome,
                   dataSaida, dataPrevista, dataVolta: null };
    return { ok: true, emprestimos: [...emprestimos, novo] };
  }

  function formatarData(iso) {
    const [a, m, d] = iso.split("-");
    return `${d}/${m}/${a}`;
  }

  // registrarVolta(emprestimos, notebook, hoje) e mudarDataPrevista(emprestimos, notebook, novaData)
  // seguem o mesmo contrato: { ok: true, emprestimos } | { ok: false, erro }

  return { NOTEBOOKS, hojeISO, dataValida, emprestimoAtivo, estaAtrasado,
           registrarSaida, formatarData };
})();
```

### Pattern 3: Armazenamento que nunca sobrescreve dado estragado

```js
// armazenamento.js
window.Armazenamento = (function () {
  const CHAVE = "emprestimos-notebooks:v1";

  function carregar() {
    let bruto;
    try { bruto = localStorage.getItem(CHAVE); }
    catch (e) { console.error("[emprestimos] localStorage indisponível", e);
                return { ok: false, motivo: "indisponivel" }; }
    if (bruto === null) return { ok: true, emprestimos: [] };
    try {
      const dados = JSON.parse(bruto);
      if (!Array.isArray(dados)) throw new Error("não é lista");
      return { ok: true, emprestimos: dados };
    } catch (e) {
      console.error("[emprestimos] dado corrompido; gravação bloqueada", e);
      return { ok: false, motivo: "corrompido" };
    }
  }

  function salvar(emprestimos) {
    try { localStorage.setItem(CHAVE, JSON.stringify(emprestimos)); return { ok: true }; }
    catch (e) { console.error("[emprestimos] falha ao salvar", e);
                return { ok: false, motivo: "indisponivel" }; }
  }

  return { CHAVE, carregar, salvar };
})();
```

### Pattern 4: Ordem de carga na página

```html
<link rel="stylesheet" href="estilo.css">
<!-- ... corpo da página ... -->
<script src="regras.js"></script>
<script src="armazenamento.js"></script>
<script src="tela.js"></script>
<script>Tela.iniciar();</script>
```

