## Code Patterns

### Pattern 1: Modelo de dados e script clássico com objeto global

```javascript
// regras.js — carregado com <script src="regras.js"></script> (SEM type="module")
// Empréstimo guardado:
// { id: "1731590000000", notebook: 1, funcionario: "Ana",
//   dataSaida: "2026-11-14", dataPrevista: "2026-11-20", dataVolta: null }
(function () {
  "use strict";

  var NOTEBOOKS = [1, 2, 3, 4, 5, 6];

  function emprestimoAtivo(emprestimos, notebook) {
    return emprestimos.find(function (e) {
      return e.notebook === notebook && e.dataVolta === null;
    }) || null;
  }

  function estaAtrasado(emprestimo, hoje) {
    return emprestimo.dataVolta === null && emprestimo.dataPrevista < hoje;
  }

  window.Regras = {
    NOTEBOOKS: NOTEBOOKS,
    emprestimoAtivo: emprestimoAtivo,
    estaAtrasado: estaAtrasado
    // + hojeLocal, registrarSaida, registrarVolta, alterarDataPrevista
  };
})();
```

### Pattern 2: Resultado explícito, nunca lançar erro para regra de negócio

```javascript
function registrarSaida(emprestimos, dados, hoje) {
  var nome = (dados.funcionario || "").trim();
  if (nome === "") return { ok: false, motivo: "Digite o nome do funcionário." };
  if (!dados.dataSaida || !dados.dataPrevista) return { ok: false, motivo: "Preencha as duas datas." };
  if (dados.dataPrevista < dados.dataSaida) {
    return { ok: false, motivo: "A data prevista não pode ser antes da data de saída." };
  }
  var ativo = emprestimoAtivo(emprestimos, dados.notebook);
  if (ativo) {
    return { ok: false, motivo: "Notebook " + dados.notebook + " já está com " + ativo.funcionario + "." };
  }
  var novo = {
    id: String(Date.now()), notebook: dados.notebook, funcionario: nome,
    dataSaida: dados.dataSaida, dataPrevista: dados.dataPrevista, dataVolta: null
  };
  return { ok: true, emprestimos: emprestimos.concat([novo]) };
}
```

### Pattern 3: Data de hoje no horário local

```javascript
function hojeLocal() {
  var d = new Date();
  var mm = String(d.getMonth() + 1).padStart(2, "0");
  var dd = String(d.getDate()).padStart(2, "0");
  return d.getFullYear() + "-" + mm + "-" + dd; // NUNCA usar toISOString() (UTC)
}
```

### Pattern 4: Armazenamento que nunca finge sucesso

```javascript
// armazenamento.js
(function () {
  "use strict";
  var CHAVE = "emprestimo-notebooks.v1";

  function ler() {
    var texto;
    try { texto = localStorage.getItem(CHAVE); }
    catch (e) { return { ok: false, motivo: "O Chrome bloqueou o acesso aos dados desta página." }; }
    if (texto === null) return { ok: true, emprestimos: [] };
    try {
      var dados = JSON.parse(texto);
      if (!Array.isArray(dados)) throw new Error("formato inesperado");
      return { ok: true, emprestimos: dados };
    } catch (e) {
      return { ok: false, motivo: "Os dados guardados estão ilegíveis. Nada foi apagado." };
    }
  }

  function gravar(emprestimos) {
    try {
      localStorage.setItem(CHAVE, JSON.stringify(emprestimos));
      return { ok: true };
    } catch (e) {
      return { ok: false, motivo: "O Chrome não conseguiu guardar. O registro NÃO foi salvo." };
    }
  }

  window.Armazenamento = { ler: ler, gravar: gravar };
})();
```

### Pattern 5: Fluxo de gravação na tela (reler → regra → gravar → redesenhar)

```javascript
function aoRegistrarSaida(dados) {
  var lido = Armazenamento.ler();               // relê: outra aba pode ter gravado
  if (!lido.ok) return mostrarAvisoTopo(lido.motivo);
  var r = Regras.registrarSaida(lido.emprestimos, dados, Regras.hojeLocal());
  if (!r.ok) return mostrarMotivo(r.motivo);    // ex.: "Notebook 1 já está com Ana."
  var g = Armazenamento.gravar(r.emprestimos);
  if (!g.ok) return mostrarAvisoTopo(g.motivo);
  desenhar(r.emprestimos);
}
// Texto digitado vai para a página SEMPRE com elemento.textContent, nunca innerHTML.
```

