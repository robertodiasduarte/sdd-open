## Code Patterns

### Pattern 1: Namespace global e configuração (`js/config.js`)

```javascript
(function () {
  'use strict';
  var ns = (window.EmprestimoNotebooks = window.EmprestimoNotebooks || {});
  ns.config = {
    chaveArmazenamento: 'emprestimo-notebooks:v1',
    chaveTeste: 'emprestimo-notebooks:teste',
    notebooks: [
      { id: 'nb1', nome: 'Notebook 1' },
      { id: 'nb2', nome: 'Notebook 2' },
      { id: 'nb3', nome: 'Notebook 3' },
      { id: 'nb4', nome: 'Notebook 4' },
      { id: 'nb5', nome: 'Notebook 5' },
      { id: 'nb6', nome: 'Notebook 6' }
    ]
  };
})();
```

### Pattern 2: Regra pura com resultado `{ ok, ... }` (`js/regras.js`)

```javascript
(function (ns) {
  'use strict';

  function hojeISO(agora) {
    var d = agora || new Date();
    return d.getFullYear() + '-' +
      String(d.getMonth() + 1).padStart(2, '0') + '-' +
      String(d.getDate()).padStart(2, '0');
  }

  function emprestimoAtivo(estado, notebookId) {
    return estado.emprestimos.find(function (e) {
      return e.notebookId === notebookId && e.dataVolta === null;
    }) || null;
  }

  function registrarSaida(estado, dados) {
    var funcionario = (dados.funcionario || '').trim();
    if (!funcionario) return { ok: false, erro: 'Informe o nome do funcionário.' };
    if (!/^\d{4}-\d{2}-\d{2}$/.test(dados.dataPrevista || '')) {
      return { ok: false, erro: 'Informe a data prevista de volta.' };
    }
    var ativo = emprestimoAtivo(estado, dados.notebookId);
    if (ativo) {
      return { ok: false, erro: 'Este notebook já está emprestado para ' + ativo.funcionario + '.' };
    }
    var novo = {
      id: Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8),
      notebookId: dados.notebookId,
      funcionario: funcionario.slice(0, 80),
      dataSaida: dados.dataSaida || hojeISO(),
      dataPrevista: dados.dataPrevista,
      dataVolta: null
    };
    return { ok: true, estado: { versao: 1, emprestimos: estado.emprestimos.concat([novo]) } };
  }

  function estaAtrasado(emprestimo, hoje) {
    return emprestimo.dataVolta === null && emprestimo.dataPrevista < hoje;
  }

  ns.regras = { hojeISO: hojeISO, emprestimoAtivo: emprestimoAtivo,
                registrarSaida: registrarSaida, estaAtrasado: estaAtrasado };
})(window.EmprestimoNotebooks);
```

### Pattern 3: Armazenamento que nunca apaga dado corrompido (`js/armazenamento.js`)

```javascript
(function (ns) {
  'use strict';

  function carregar(chave) {
    var bruto;
    try { bruto = window.localStorage.getItem(chave); }
    catch (e) { return { ok: false, erro: 'armazenamento-indisponivel' }; }
    if (bruto === null) return { ok: true, estado: ns.regras.estadoVazio() };
    try {
      var estado = JSON.parse(bruto);
      if (!ns.regras.estadoValido(estado)) throw new Error('formato');
      return { ok: true, estado: estado };
    } catch (e) {
      return { ok: false, erro: 'dados-corrompidos', bruto: bruto };
    }
  }

  function salvar(chave, estado) {
    try {
      window.localStorage.setItem(chave, JSON.stringify(estado));
      return { ok: true };
    } catch (e) {
      return { ok: false, erro: 'falha-ao-gravar' };
    }
  }

  ns.armazenamento = { carregar: carregar, salvar: salvar };
})(window.EmprestimoNotebooks);
```

### Pattern 4: Operação na tela (reler → regra → gravar → redesenhar) e desenho seguro

```javascript
function aoRegistrarSaida(dados) {
  var lido = ns.armazenamento.carregar(ns.config.chaveArmazenamento);
  if (!lido.ok) return mostrarErro(mensagemDoErro(lido.erro));
  var r = ns.regras.registrarSaida(lido.estado, dados);
  if (!r.ok) return mostrarErro(r.erro);
  var g = ns.armazenamento.salvar(ns.config.chaveArmazenamento, r.estado);
  if (!g.ok) return mostrarErro(mensagemDoErro(g.erro));
  desenhar(r.estado);
  mostrarSucesso('Saída registrada.');
}

// Nunca usar innerHTML com dados digitados:
celulaNome.textContent = emprestimo.funcionario;
linha.classList.toggle('atrasado', ns.regras.estaAtrasado(emprestimo, ns.regras.hojeISO()));
```

### Pattern 5: Teste sem framework (`testes/testes.js`)

```javascript
var resultados = [];
function teste(nome, fn) {
  try { fn(); resultados.push({ nome: nome, ok: true }); }
  catch (e) { resultados.push({ nome: nome, ok: false, erro: e.message }); }
}
function igual(obtido, esperado, msg) {
  if (obtido !== esperado) throw new Error((msg || '') + ' esperado=' + esperado + ' obtido=' + obtido);
}

teste('AT-002: recusa saída de notebook emprestado e diz com quem está', function () {
  var R = window.EmprestimoNotebooks.regras;
  var e1 = R.registrarSaida(R.estadoVazio(), { notebookId: 'nb1', funcionario: 'Ana', dataPrevista: '2026-11-20' });
  var e2 = R.registrarSaida(e1.estado, { notebookId: 'nb1', funcionario: 'Bruno', dataPrevista: '2026-11-21' });
  igual(e2.ok, false);
  igual(e2.erro.indexOf('Ana') >= 0, true, 'mensagem cita Ana');
});
```

