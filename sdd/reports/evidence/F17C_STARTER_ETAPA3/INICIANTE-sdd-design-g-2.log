## Code Patterns

### Pattern 1: Formato do dado guardado

```js
// localStorage["emprestimoNotebooks.v1"] = JSON de um array:
// {
//   notebook: 1,                 // inteiro de 1 a 6
//   funcionario: "Ana",          // texto, sem espaços nas pontas, até 60 caracteres
//   dataSaida: "2026-11-12",     // AAAA-MM-DD
//   dataPrevista: "2026-11-13",  // AAAA-MM-DD, >= dataSaida
//   dataVolta: null              // null = emprestado; "AAAA-MM-DD" = devolvido
// }
// Empréstimos devolvidos permanecem no array (não são exibidos).
```

### Pattern 2: Regras puras (regras.js)

```js
var Regras = (function () {
  var TOTAL_NOTEBOOKS = 6;
  var MAX_NOME = 60;
  var DATA = /^\d{4}-\d{2}-\d{2}$/;

  // Data local do computador; não usar toISOString() (UTC adianta o dia à noite no Brasil).
  function hojeLocal(agora) {
    var d = agora || new Date();
    return d.getFullYear() + "-" +
      String(d.getMonth() + 1).padStart(2, "0") + "-" +
      String(d.getDate()).padStart(2, "0");
  }

  function formatarData(iso) {
    var p = iso.split("-");
    return p[2] + "/" + p[1] + "/" + p[0];
  }

  function emprestimoAtivo(lista, notebook) {
    return lista.find(function (e) {
      return e.notebook === notebook && e.dataVolta === null;
    }) || null;
  }

  function registrarSaida(lista, pedido) {
    var nome = (pedido.funcionario || "").trim();
    var n = Number(pedido.notebook);
    if (!(n >= 1 && n <= TOTAL_NOTEBOOKS && Number.isInteger(n))) return { ok: false, erro: "Escolha um notebook." };
    if (!nome) return { ok: false, erro: "Informe o nome do funcionário." };
    if (nome.length > MAX_NOME) return { ok: false, erro: "Nome com no máximo " + MAX_NOME + " caracteres." };
    if (!DATA.test(pedido.dataSaida || "")) return { ok: false, erro: "Informe a data de saída." };
    if (!DATA.test(pedido.dataPrevista || "")) return { ok: false, erro: "Informe a data prevista de volta." };
    if (pedido.dataPrevista < pedido.dataSaida) return { ok: false, erro: "A data prevista não pode ser antes da saída." };

    var ativo = emprestimoAtivo(lista, n);
    if (ativo) {
      return { ok: false, erro: "O Notebook " + n + " está com " + ativo.funcionario +
        " desde " + formatarData(ativo.dataSaida) + "." };
    }
    var novo = { notebook: n, funcionario: nome, dataSaida: pedido.dataSaida,
                 dataPrevista: pedido.dataPrevista, dataVolta: null };
    return { ok: true, lista: lista.concat([novo]) };
  }

  function registrarVolta(lista, notebook, hoje) {
    var ativo = emprestimoAtivo(lista, notebook);
    if (!ativo) return { ok: false, erro: "O Notebook " + notebook + " já está livre." };
    return { ok: true, lista: lista.map(function (e) {
      return e === ativo ? Object.assign({}, e, { dataVolta: hoje }) : e;
    }) };
  }

  // Atrasado = ainda emprestado e a data prevista é anterior a hoje ("vence hoje" não é atraso).
  function estaAtrasado(emp, hoje) {
    return emp.dataVolta === null && emp.dataPrevista < hoje;
  }

  return { TOTAL_NOTEBOOKS: TOTAL_NOTEBOOKS, hojeLocal: hojeLocal, formatarData: formatarData,
           emprestimoAtivo: emprestimoAtivo, registrarSaida: registrarSaida,
           registrarVolta: registrarVolta, estaAtrasado: estaAtrasado };
})();
```

### Pattern 3: Armazenamento tolerante a falhas (armazenamento.js)

```js
var Armazenamento = (function () {
  function criar(storage, chave) {
    return {
      ler: function () {
        try {
          var bruto = storage.getItem(chave);
          if (bruto === null) return { ok: true, lista: [] };
          var lista = JSON.parse(bruto);
          if (!Array.isArray(lista)) throw new Error("formato inesperado");
          return { ok: true, lista: lista };
        } catch (e) {
          console.error("[emprestimos] leitura falhou", e);
          return { ok: false, erro: "Os dados guardados estão ilegíveis ou inacessíveis. Nada foi apagado." };
        }
      },
      gravar: function (lista) {
        try {
          storage.setItem(chave, JSON.stringify(lista));
          return { ok: true };
        } catch (e) {
          console.error("[emprestimos] gravação falhou", e);
          return { ok: false, erro: "Não consegui guardar. Nada foi registrado." };
        }
      }
    };
  }
  return { criar: criar };
})();
```

### Pattern 4: Ciclo da Tela (tela.js) e ordem dos scripts (index.html)

```js
// tela.js: sempre relê antes de gravar (protege contra outra aba aberta)
var banco = Armazenamento.criar(window.localStorage, "emprestimoNotebooks.v1");

function aoRegistrarSaida(pedido) {
  var leitura = banco.ler();
  if (!leitura.ok) return entrarSomenteLeitura(leitura.erro);
  var r = Regras.registrarSaida(leitura.lista, pedido);
  if (!r.ok) return mostrarErro(r.erro);
  var g = banco.gravar(r.lista);
  if (!g.ok) return mostrarErro(g.erro);   // não redesenha com dado não salvo
  desenhar(r.lista);
}
// Texto vindo da gerente entra sempre via textContent, nunca innerHTML.
```

```html
<link rel="stylesheet" href="estilo.css">
<!-- scripts clássicos: type="module" é bloqueado em file:// -->
<script src="armazenamento.js"></script>
<script src="regras.js"></script>
<script src="tela.js"></script>
```

