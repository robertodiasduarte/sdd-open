-SKILL = Path(__file__).resolve().parents[1]
-VALIDATOR = SKILL / "scripts" / "validate_define.py"
-EXEMPLO = SKILL / "assets" / "DEFINE_EXEMPLO.md"
-
-GATE = """```yaml
-verify_gate:
-  kind: %(kind)s
-  cmd: %(cmd)s
-  pass_when: "exit 0"
-  threshold: %(threshold)s
-  manual_fallback: %(fallback)s
-```
-"""
-
-BASE = """# DEFINE: Teste
-
-> DEFINE mínimo para o validador
-
-## Metadata
-
-| Attribute | Value |
-|---|---|
-| **Feature** | TESTE |
