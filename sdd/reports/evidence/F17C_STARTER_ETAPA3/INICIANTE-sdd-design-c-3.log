## Code Patterns

### Pattern 1: Regras puras (`emprestimos/regras.js`)

```javascript
// Sem acesso à tela nem ao armazenamento: recebe a lista e devolve uma nova.
var NOTEBOOKS = ["Notebook 1", "Notebook 2", "Notebook 3",
                 "Notebook 4", "Notebook 5", "Notebook 6"];

var Regras = {
  registrarSaida: function (emprestimos, pedido) {
    var campos = [["notebook", "Notebook"], ["funcionario", "Funcionário"],
                  ["saida", "Data de saída"], ["prevista", "Data prevista de volta"]];
    for (var i = 0; i < campos.length; i++) {
      if (!String(pedido[campos[i][0]] || "").trim()) {
        return { ok: false, erro: "Preencha o campo " + campos[i][1] + "." };
      }
    }
    if (NOTEBOOKS.indexOf(pedido.notebook) === -1) {
      return { ok: false, erro: "Notebook desconhecido." };
    }
    var atual = emprestimos.find(function (e) { return e.notebook === pedido.notebook; });
    if (atual) {
      return { ok: false, erro: "O " + pedido.notebook + " já está com " + atual.funcionario + "." };
    }
    if (pedido.prevista < pedido.saida) {
      return { ok: false, erro: "A data prevista de volta não pode ser antes da data de saída." };
    }
    var novo = { notebook: pedido.notebook, funcionario: pedido.funcionario.trim(),
                 saida: pedido.saida, prevista: pedido.prevista };
    return { ok: true, emprestimos: emprestimos.concat([novo]) };
  },

  registrarVolta: function (emprestimos, notebook) {
    return { ok: true, emprestimos: emprestimos.filter(function (e) { return e.notebook !== notebook; }) };
  },

  estaAtrasado: function (emprestimo, hoje) {   // hoje = "AAAA-MM-DD"
    return emprestimo.prevista < hoje;
  },

  hojeLocal: function (agora) {                 // nunca usar toISOString (fuso de Greenwich)
    var d = agora || new Date();
    return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") +
           "-" + String(d.getDate()).padStart(2, "0");
  }
};
```

### Pattern 2: Armazenamento que não apaga dado ilegível (`emprestimos/armazenamento.js`)

```javascript
var CHAVE_EMPRESTIMOS = "emprestimos-notebooks-v1";

var Armazenamento = {
  ler: function () {
    var texto;
    try { texto = localStorage.getItem(CHAVE_EMPRESTIMOS); }
    catch (e) { console.error("Armazenamento indisponível", e); return { ok: false, erro: "indisponivel" }; }
    if (texto === null) return { ok: true, emprestimos: [] };
    try {
      var dados = JSON.parse(texto);
      if (!Array.isArray(dados)) throw new Error("formato inesperado");
      return { ok: true, emprestimos: dados };
    } catch (e) {
      console.error("Dados guardados ilegíveis", e);
      return { ok: false, erro: "ilegivel" };   // a Tela bloqueia gravação para não sobrescrever
    }
  },

  gravar: function (emprestimos) {
    try { localStorage.setItem(CHAVE_EMPRESTIMOS, JSON.stringify(emprestimos)); return true; }
    catch (e) { console.error("Falha ao gravar", e); return false; }
  }
};
```

### Pattern 3: Texto digitado sempre como texto puro (`emprestimos/tela.js`)

```javascript
// Nunca usar innerHTML com dados digitados pela gerente.
var celula = document.createElement("td");
celula.textContent = emprestimo.funcionario;
if (Regras.estaAtrasado(emprestimo, Regras.hojeLocal())) {
  linha.classList.add("atrasado");
}
```

### Pattern 4: Ordem dos scripts (`emprestimos/index.html`)

```html
<link rel="stylesheet" href="estilo.css">
<!-- ... conteúdo da página ... -->
<script src="regras.js"></script>
<script src="armazenamento.js"></script>
<script src="tela.js"></script>
```

