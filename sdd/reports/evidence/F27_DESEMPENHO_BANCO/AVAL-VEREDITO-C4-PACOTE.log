echo "--- AT-010 bash -n (3.2) nos 2 scripts"; for s in sdd/bin/desempenho-*.sh; do /bin/bash -n $s && echo "   $s ok"; done
echo "--- Verify Gate: última evidência do Build (não rodado aqui)"; tail -3 sdd/reports/evidence/F27_DESEMPENHO_BANCO/GATE.log
echo "--- AT-007 SQL de references/ só de leitura: verbos de escrita fora de comentário nos blocos \`\`\`sql"
/usr/bin/python3 -I - .agents/skills/sdd-desempenho-banco/references <<'PYX'
import os,re,sys
proib=r"\b(insert|update|delete|merge|alter|create|drop|truncate|grant|revoke|vacuum|reindex|cluster|refresh|pg_cancel_backend|pg_terminate_backend)\b"
n=0; ruins=[]
for nome in sorted(os.listdir(sys.argv[1])):
    t=open(os.path.join(sys.argv[1],nome),encoding='utf-8').read()
    for b in re.findall(r"```sql\n(.*?)```",t,re.S):
        n+=1
        s=re.sub(r"--[^\n]*|/\*.*?\*/","",b,flags=re.S); s=re.sub(r"'[^']*'","''",s)
        s2=re.sub(r"(?is)\bexplain\s*\([^)]*\)|\bexplain\b","",s)
        if re.search(proib,s,re.I) or re.search(r"\banalyze\b",s2,re.I) and not re.search(r"(?is)\bbegin\b.*\brollback\b",s):
            ruins.append((nome,b.strip()[:60]))
print("   blocos sql: %d · com escrita: %d %s"%(n,len(ruins),ruins[:3]))
PYX
