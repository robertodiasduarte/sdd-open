grep -nE 'desempenho-varredura' .agents/skills/sdd-release/SKILL.md | head -3
grep -nE 'CONCERNS' .agents/skills/sdd-release/SKILL.md | grep -iE 'desempenho|64|127' | head -3
echo "--- AT-009 pacote: MANIFEST, lista do starter, README"
grep -cE 'sdd-desempenho-banco|desempenho-(varredura|diagnostico)\.sh' MANIFEST.txt
grep -nE '^sdd/(features|handoffs|reports|reviews|releases|contexto)/' MANIFEST.txt | wc -l | tr -d ' ' | sed 's/^/   documentos da frente no MANIFEST: /'
grep -n 'desempenho' scripts/starter/lista.txt
grep -c 'sdd-desempenho-banco' README.md README.pt-BR.md
