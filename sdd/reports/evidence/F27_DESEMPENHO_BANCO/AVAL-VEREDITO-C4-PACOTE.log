f=$(git ls-files | grep 'AGENTS.md.tmpl$' | head -1); git diff 2204a14 HEAD -- "$f" | grep -E '^[+-][^+-]' | cut -c1-60
echo "--- AT-010 intocados desde 2204a14: seguranca-varredura.sh, verify-gate.sh, publish-gate.sh, lib/python.sh"
for x in sdd/bin/seguranca-varredura.sh sdd/bin/verify-gate.sh scripts/publish-gate.sh sdd/bin/lib/python.sh; do git diff --quiet 2204a14 HEAD -- $x && echo "   $x: sem diferença" || echo "   $x: MUDOU"; done
