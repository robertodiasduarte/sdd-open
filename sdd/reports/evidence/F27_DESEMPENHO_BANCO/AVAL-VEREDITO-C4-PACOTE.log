# p4.sh — veredito ciclo 4: AT-009/AT-010 por execução no repositório (só leitura; nenhum módulo de teste, a suíte está
# rodando em paralelo): catálogo, skill, ganchos das 3 skills de fase, pacote, lints leves e não-regressão por diff.
cd /Users/robertoduarte/rdd-worktrees/sdd-open-f27-db-performance
echo "HEAD: $(git rev-parse --short HEAD) · árvore limpa: $(git status --porcelain | grep -vc '^?? sdd/reports/evidence/F27_DESEMPENHO_BANCO/AVAL-VEREDITO-C4' )"
SK=.agents/skills/sdd-desempenho-banco; K=$SK/references/CATALOGO_DESEMPENHO.md
echo "--- AT-009 fichas P01–P17 (### Pnn) e campos de cada ficha"
grep -oE '^### P[0-9]{2}' $K | tr -d '#' | tr '\n' ' '; echo; echo "   total: $(grep -cE '^### P[0-9]{2} ' $K)"
/usr/bin/python3 -I - "$K" <<'EOF'
import re,sys
t=open(sys.argv[1],encoding='utf-8').read()
fichas=re.split(r'(?m)^### ',t)[1:]
esp=['stack','fase','gravidade','gatilho','padrao','arquivos','frase','evitar','at','confira','ref']
ruins=[]
for f in fichas:
    nome=f.split('\n',1)[0][:3]
    campos=re.findall(r'(?m)^- ([a-z]+):()',f)
    cs=[a or b for a,b in campos]
    cs=[c for c in cs if c in esp+['bloqueia','agents']]
    if cs!=esp: ruins.append((nome,cs))
print("   fichas com os 11 campos na ordem, sem bloqueia/agents: %d de %d%s"%(len(fichas)-len(ruins),len(fichas),"" if not ruins else " · fora: %s"%ruins[:3]))
EOF
echo "--- AT-009 skill: arquivos, modos, Como falar, versão"
ls $SK $SK/references $SK/evals | tr '\n' ' '; echo
grep -nE '^#+ .*(Define|Design|release|Release|diagn|Diagn|Como falar)' $SK/SKILL.md | head -10
grep -nE '^\s*version:' $SK/SKILL.md
echo "--- AT-009 ganchos nas skills de fase"
