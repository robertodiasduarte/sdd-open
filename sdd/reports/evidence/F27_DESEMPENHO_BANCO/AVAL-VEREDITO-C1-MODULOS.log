# m1.sh — módulos de teste isolados, um por vez, numa cópia de git archive (HEAD), com o bash 3.2; e a linha de base
# vermelha: os testes novos rodados sobre uma cópia de 2204a14 (v2.21.0). Nunca a suíte inteira.
set -u
W=/Users/robertoduarte/rdd-worktrees/sdd-open-f27-db-performance
T=$(mktemp -d); git -C $W archive HEAD | tar -x -C $T; cd $T
echo "HEAD $(git -C $W rev-parse --short HEAD) em <copia>"
for m in test_desempenho_varredura test_desempenho_diagnostico test_desempenho_catalogo test_f27_textos test_seguranca_varredura test_agnostico test_skill_lint test_gerar_starter test_bash32; do
  ini=$(date +%s)
  SDD_TEST_BASH=/bin/bash /usr/bin/python3 -B -m unittest discover -s tests -p "$m.py" > $T/_out 2>&1; rc=$?
  echo "== $m: exit=$rc · $(grep -E '^Ran ' $T/_out) · $(tail -1 $T/_out) · $(( $(date +%s) - ini ))s"
  [ $rc -ne 0 ] && grep -E '^(FAIL|ERROR):' $T/_out | head -10
done
echo "== linha de base: os 4 módulos novos sobre 2204a14"
B=$(mktemp -d); git -C $W archive 2204a14 | tar -x -C $B
for m in test_desempenho_varredura test_desempenho_diagnostico test_desempenho_catalogo test_f27_textos; do
  cp $W/tests/$m.py $B/tests/
  (cd $B && SDD_TEST_BASH=/bin/bash /usr/bin/python3 -B -m unittest discover -s tests -p "$m.py" > $B/_out 2>&1); rc=$?
  echo "   $m em 2204a14: exit=$rc · $(grep -E '^Ran ' $B/_out) · $(tail -1 $B/_out)"
done
rm -rf $T $B
