import re, sys
t = open(sys.argv[1], encoding="utf-8").read().split("## Itens", 1)[1]
blocos = re.split(r"\n(?=### )", t.strip())
ids = [re.match(r"### (P\d\d) — ", b).group(1) for b in blocos]
ordem = ["stack","fase","gravidade","gatilho","padrao","arquivos","frase","evitar","at","confira","ref"]
print("fichas:", len(ids), "ids ok:", ids == ["P%02d" % k for k in range(1, 18)])
ruins = 0
for b in blocos:
    campos = [m.group(1) for m in re.finditer(r"^- ([a-z]+):", b, re.M)]
    if campos != ordem:
        ruins += 1; print("  fora da ordem:", b[:8], campos)
print("fichas com os 11 campos na ordem:", len(blocos) - ruins, "· com bloqueia/agents:", sum(bool(re.search(r"^- (bloqueia|agents):", b, re.M)) for b in blocos))
com = [b[4:7] for b in blocos if not re.search(r"^- padrao: só à mão", b, re.M)]
print("fichas com padrão:", len(com), com)
PY
