$ cat /private/tmp/claude-501/-Users-robertoduarte-rdd-worktrees-sdd-open-f27-db-performance/1c932530-2974-4176-9efc-5abde2eaf63f/scratchpad/c4/d4.sh; bash /private/tmp/claude-501/-Users-robertoduarte-rdd-worktrees-sdd-open-f27-db-performance/1c932530-2974-4176-9efc-5abde2eaf63f/scratchpad/c4/d4.sh
# d4.sh — veredito ciclo 4: confere os 3 achados do ciclo 3 no diagnóstico de uma cópia git archive de HEAD 5af0a2d;
# supabase falso fora do projeto; senha e nome montados em tempo de execução e trocados na saída.
# Cada caso de máscara roda com o python3 do PATH e com o /usr/bin/python3 (3.9) do sistema.
set -u
H=/private/tmp/claude-501/-Users-robertoduarte-rdd-worktrees-sdd-open-f27-db-performance/1c932530-2974-4176-9efc-5abde2eaf63f/scratchpad/c4/head
D=$H/sdd/bin/desempenho-diagnostico.sh; V=$H/sdd/bin/desempenho-varredura.sh
S=$(mktemp -d); SEG="$(printf '%s%s%s' Zk7 Wm2 Qx9)"; NOME="$(printf '%s%s' Mar ta)"
mkdir -p $S/bin $S/py39 $S/proj $S/fx && (cd $S/proj && git init -q)
ln -s /usr/bin/python3 $S/py39/python3
printf '#!/bin/bash\nprintf "%%s\\n" "$*" >> "$SDD_FAKE_LOG"\ncase "$*" in --version) echo 2.100.1 ;; *) echo "[]" ;; esac\n' > $S/bin/supabase; chmod +x $S/bin/supabase
export PATH="$S/bin:$PATH" SDD_FAKE_LOG=$S/log
P0="$PATH"
tapa() { sed "s/$SEG/<SENHA>/g; s/$NOME/<NOME>/g; s#$S#<TMP>#g"; }
roda() { : > $S/log; (cd $S/proj && bash $D "$@"); echo "[exit=$?] chamadas ao supabase: $(wc -l < $S/log | tr -d ' ')"; }
gravados() { (cd $S/proj && find . -path ./.git -prune -o -type f -print | tapa); }
q() { /usr/bin/python3 -I -c "import json,sys; json.dump([{'query':sys.argv[2],'total_exec_time':'9s'}], open(sys.argv[1],'w'))" $S/fx/long-running-queries.json "$1"; }
echo "python3 do PATH: $(python3 --version 2>&1) · /usr/bin/python3: $(/usr/bin/python3 --version 2>&1)"

echo "######## ACHADO 1 — string de conexão chave=valor (libpq) como valor de opção ou solta: 64, 0 chamadas, nada gravado, senha ausente"
KV="host=dbhost user=postgres password=$SEG dbname=postgres"
echo "--- 1a --coletar --consentimento --saida \"<kv com password=>\""
roda --coletar --consentimento --saida "$KV" > $S/o 2>&1; tapa < $S/o
echo "   senha na saída: $(grep -c "$SEG" $S/o) · arquivos gravados no projeto:"; gravados; echo "   (fim da lista)"
echo "--- 1b --ler <pasta> --saida \"<kv com password=>\""
echo '[{"name":"x_lint","level":"WARN","categories":["PERFORMANCE"],"detail":"d"}]' > $S/fx/advisors.json
roda --ler $S/fx --saida "$KV" > $S/o 2>&1; tapa < $S/o
echo "   senha na saída: $(grep -c "$SEG" $S/o) · arquivos gravados no projeto:"; gravados; echo "   (fim da lista)"
echo "--- 1c variantes: solta na coleta; solta no --ler; --saida=<kv>; PGPASSWORD=; password = 'com espaço'; PASSWORD maiúsculo; em --estatisticas-desde; em --ler"
for args in "--coletar|--consentimento|$KV" \
            "--ler|$S/fx|$KV" \
            "--ler|$S/fx|--saida=$KV" \
            "--coletar|--consentimento|--saida|PGPASSWORD=$SEG" \
            "--ler|$S/fx|--saida|host=h password = '$SEG x' dbname=d" \
            "--ler|$S/fx|--saida|host=h PASSWORD=$SEG" \
            "--coletar|--consentimento|--estatisticas-desde|host=h password=$SEG" \
            "--ler|host=h password=$SEG"; do
  IFS='|' read -r -a A <<< "$args"
  printf '   %s → ' "$(printf '%s ' "${A[@]}" | tapa)"
  roda "${A[@]}" > $S/o 2>&1; printf '%s · senha: %s · gravados: %s\n' "$(tail -1 $S/o)" "$(grep -c "$SEG" $S/o)" "$(gravados | wc -l | tr -d ' ')"
done
echo "--- 1d (observação) kv SEM senha como --saida: o que acontece"
roda --ler $S/fx --saida "host=dbhost dbname=postgres" > $S/o 2>&1; tail -1 $S/o; echo "   gravados:"; gravados; rm -f "$S/proj/host=dbhost dbname=postgres"
rm -f $S/fx/advisors.json

echo "######## ACHADO 2 — máscara do texto do banco (long-running-queries.json → --ler <pasta> --saida fora do projeto)"
mask() {
  q "$1"; echo "--- entrada: $(printf '%s' "$1" | tapa)"
  for pp in "$P0" "$S/py39:$P0"; do
    PATH="$pp" roda --ler $S/fx --saida $S/saida.txt > $S/o 2>&1
    printf '   [%s] ' "$(PATH="$pp" python3 --version 2>&1)"; tapa < $S/o | grep -E '^   │' | sed 's/^   //'
    echo "      nome na tela: $(grep -c "$NOME" $S/o) · nome no --saida: $(grep -c "$NOME" $S/saida.txt) · senha: $(cat $S/o $S/saida.txt | grep -c "$SEG") · $(grep -E '^\[exit' $S/o)"
  done
}
mask "select \"it's\" from c where nome = '$NOME'"
mask "select * from \"o'brien\" where nome = '$NOME'"
mask "select * from c /* a /* x */ it's */ where nome = '$NOME'"
mask "select * from c /* a /* x */ $NOME */ where id = 1"
echo "######## ACHADO 2 — bordas extras (mesma máscara)"
mask "select \"a\"\"b's\" from c where nome = '$NOME'"
mask "select \"x/*\" from c where nome = '$NOME'"
mask "select * from c where nome = '/* $NOME */'"
mask "select * from c where a = E'x\\\\' and nome = '$NOME'"
mask "select * from c where a = e'it\\'s' and nome = '$NOME'"
mask "select * from c where nome like'$NOME%'"
mask "select * from c where nome = U&'$NOME'"
mask "select * from c where nome = \$q\$$NOME\$q\$ and k = 1"
mask "select * from c /* aberto $NOME"
mask "select * from c where nome = '$NOME"
mask "select * from c where nome = \"$NOME"
mask "select * from c where x = 1 */ and nome = '$NOME'"
mask "select * from c where nome = '$NOME' -- it's"
mask "select 1 -- password = '$SEG'"
mask "select * from c where nome = '$(printf '%s\n' "$NOME")' and id = 42"

echo "######## ACHADO 3 — núcleo Python embutido nos 2 scripts compila com -W error (python3 do PATH e /usr/bin/python3)"
sed -n "/<<'PY'$/,/^PY$/p" $D | sed '1d;$d' > $S/n_diag.py
sed -n "/<<'PY'$/,/^PY$/p" $V | sed '1d;$d' > $S/n_varr.py
for f in $S/n_diag.py $S/n_varr.py; do
  for py in python3 /usr/bin/python3; do
    printf '%s %s (%s, %s linhas): ' "$(basename $f)" "$py" "$($py --version 2>&1)" "$(wc -l < $f | tr -d ' ')"
    $py -W error -c "import sys; compile(open(sys.argv[1], encoding='utf-8').read(), 'nucleo', 'exec'); print('compila sem aviso')" $f 2>&1 | tail -1
  done
done
echo "--- stderr de execução real (deve vir vazio): --help, --ler simples, varredura --help"
q "select 1"
for pp in "$P0" "$S/py39:$P0"; do
  printf '   [%s] diag --ler stderr: ' "$(PATH="$pp" python3 --version 2>&1)"; (cd $S/proj && PATH="$pp" bash $D --ler $S/fx 2>&1 >/dev/null | tapa | wc -l | tr -d ' ');
  printf '   [%s] varr --help stderr: ' "$(PATH="$pp" python3 --version 2>&1)"; (cd $S/proj && PATH="$pp" bash $V --help 2>&1 >/dev/null | wc -l | tr -d ' ')
done
rm -rf "${S:?}"
