### (8) passo 'Build package and checksums' do release.yml, executado num clone (tag ainda não existe)

$ cat "$T/passo-release.sh"
set -euo pipefail
mkdir -p dist
# F22: o VERSION do pacote é carimbado pelo git archive (export-subst, %(describe:tags=true)): a tag precisa
# existir AQUI antes do archive. Tag local, leve; quem a publica continua sendo o passo "Publish release".
git rev-parse -q --verify "refs/tags/$TAG" >/dev/null || git tag "$TAG" "$GITHUB_SHA"
git archive --format=tar.gz --prefix="sdd-open-$TAG/" -o "dist/sdd-open-$TAG.tar.gz" "$GITHUB_SHA"
carimbo="$(tar -xzOf "dist/sdd-open-$TAG.tar.gz" "sdd-open-$TAG/VERSION" | tr -d '\r\n')"
[ "$carimbo" = "$TAG" ] || { echo "::error::VERSION do pacote saiu '$carimbo', esperado '$TAG'"; exit 1; }
cd dist && sha256sum "sdd-open-$TAG.tar.gz" > SHA256SUMS.txt && cat SHA256SUMS.txt
