$ (cd starter && python3 -B scripts/check-gerado.py; echo rc=$?)
C() { rm -rf c; cp -R starter c; }
caso() { echo "== $1"; (cd c && python3 -B scripts/check-gerado.py 2>&1 | grep -v '^ *$'; echo rc=${PIPESTATUS[0]}); }
C; printf 'X' | dd of=c/skills/sdd-kb/SKILL.md bs=1 seek=500 conv=notrunc 2>/dev/null; caso '1 byte trocado em skills/sdd-kb/SKILL.md'
