C; echo x > c/.github/workflows/novo.yml; caso 'arquivo a mais em .github/workflows/'
C; echo '# x' >> c/skills/sdd-kb/GERADO.txt; echo y >> c/skills/sdd-kb/SKILL.md; caso 'SKILL.md e o GERADO.txt da skill editados juntos'
C; echo '' >> c/.gitattributes; caso '.gitattributes editado'
C; echo x >> c/skills/sdd-brainstorm/SKILL.md; caso 'skill congelada editada (fora da trava, deve sair 0)'
