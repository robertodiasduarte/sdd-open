$ C() { rm -rf c; cp -R starter c; }
caso() { echo "== $1"; (cd c && python3 -B scripts/check-gerado.py 2>&1 | grep -v '^ *$'; echo rc=${PIPESTATUS[0]}); }
C; rm -rf c/skills/sdd-kb; caso 'pasta inteira de uma skill gerada apagada'
C; rm c/skills/sdd-kb/GERADO.txt; echo y >> c/skills/sdd-kb/SKILL.md; caso 'GERADO.txt da skill apagado + SKILL.md editado'
C; rm c/GERADO.txt; echo x >> c/README.md; caso 'GERADO.txt da raiz apagado + README editado'
C; rm c/GERADO.txt; echo x >> c/skills/sdd-kb/SKILL.md; caso 'GERADO.txt da raiz apagado + skill editada'
C; rm c/GERADO.txt c/skills/*/GERADO.txt; echo x >> c/skills/sdd-kb/SKILL.md; echo x >> c/README.md; caso 'todos os GERADO.txt apagados + skill e README editados'
C; sed -i '' '2s/^[0-9a-f]\{4\}/0000/' c/GERADO.txt; caso 'GERADO.txt da raiz com um hash adulterado'
C; printf 'lixo sem formato\n' >> c/GERADO.txt; caso 'GERADO.txt da raiz ilegível (esperado 64 pelo DESIGN)'
