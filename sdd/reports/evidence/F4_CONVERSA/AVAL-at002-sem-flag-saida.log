$ T=$(mktemp -d) && mkdir -p $T/sdd-x && printf -- "---\nname: sdd-x\ndescription: faz\n---\n# x\n" > $T/sdd-x/SKILL.md && printf -- "---\nname: errado\ndescription: faz\n---\n" > $T/sdd-x/B.md && for v in v2.2.4 HEAD; do git show $v:sdd/bin/skill-lint.py > $T/lint-$v.py; echo "== $v: SKILL.md valido"; /usr/bin/python3 -B $T/lint-$v.py $T/sdd-x/SKILL.md; echo "rc=$?"; echo "== $v: nome errado"; /usr/bin/python3 -B $T/lint-$v.py $T/sdd-x/B.md; echo "rc=$?"; echo "== $v: argumento --verbose"; /usr/bin/python3 -B $T/lint-$v.py --verbose $T/sdd-x/SKILL.md; echo "rc=$?"; done 2>&1 | sed "s#$T#\$T#g"
