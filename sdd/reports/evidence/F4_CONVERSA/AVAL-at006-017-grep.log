$ for d in .agents/skills/sdd-*/; do s=$(basename $d); f=$d/SKILL.md; v=$(sed -n "s/^  version: \"\(.*\)\"/\1/p" $f); id=$(grep -o "$s v[0-9.]* · out/2026 · versão atual: https://github.com/robertodiasduarte/sdd-open/releases/latest" $f | sort -u | tr "\n" "|"); up=$(grep -c "^  updated: \"2026-10\"" $f); ban=$(grep -c "Abra a resposta com o banner" $f); sec=$(grep -c "^## Como falar com o aluno$" $f); leia=$(grep -c "references/como-falar.md" $f); cf=$( [ -f $d/references/como-falar.md ] && grep -c "sdd/templates/fragments/PERGUNTA_DECISAO.md" $d/references/como-falar.md || echo -); echo "$s version=$v id=[$id] updated=$up banner=$ban secao=$sec leia=$leia comofalar_cita_fragmento=$cf linhas=$(wc -l < $f | tr -d " ")"; done
