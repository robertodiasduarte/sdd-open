# sdd/config.yaml — copiado de config.example.yaml pelo `init`. Preencha para o seu projeto.
#
# As skills consultam estes slots ({{TEST_CMD}}, {{DEPLOY_CMD}}, …) em vez de fixar comandos.
# Slot VAZIO significa "pule este passo e diga que pulou" — nunca "adivinhe um comando".
# Parser: chaves simples `chave: valor` e mapas de 1 nível; sem âncoras, sem listas complexas.

project:
  name: meu-projeto
  # Comando de teste, usado por gates `kind: test`.
  test_cmd: ""
  # Checagem de tipos/compilação, usada por gates `kind: typecheck`.
  typecheck_cmd: ""
  # Checagem de sintaxe por tipo de arquivo (fase Release, passo 0a).
  lint_cmd: ""
  # Branch de onde nascem as features. Nunca se trabalha nela diretamente (o pre-commit de sdd/hooks
  # recusa commit direto nela quando ela já tem remoto).
  default_branch: main
  # Teto, em KB, do arquivo de contexto do agente (AGENTS.md, CLAUDE.md, GEMINI.md, .cursorrules) num
  # commit: ele entra inteiro em toda sessão do agente. Acima disso o pre-commit recusa. Vazio = 100.
  context_file_max_kb: 100

# Camadas do seu projeto: nome → glob. É o que diz "esta feature toca 2 camadas" — o gatilho
# do avaliador de contexto fresco. `sql` também diz o que conta como migration (report-lint.py).
# Exemplos: sql: "db/migrations/**" · api: "src/api/**" · ui: "src/ui/**" · infra: "deploy/**"
layers:
  api: "conta.py"
  ui: "tests/**"
  sql: ""

# Evidência do build (report-lint.py): a partir de quantas camadas de `layers:` tocadas pelo File
# Manifest do DESIGN a avaliação em contexto fresco é obrigatória. Abaixo disso, a linha
# `avaliador: N.A. (<motivo>)` no BUILD_REPORT vale. 1 = avaliador sempre. Inteiro >= 1.
evidence:
  require_avaliacao_layers: 2

deploy:
  # Roda na fase Release, depois da única aprovação humana.
  cmd: ""
  # Detecta o que chegou em produção sem commit correspondente (função publicada pelo console,
  # migration aplicada pelo painel). Vazio = você só deploya via git e esse drift não existe.
  drift_check_cmd: ""

release:
  # Bloqueadores próprios do projeto: começa com regras genéricas, cresce a cada incidente.
  landmines_cmd: ""
  # Opcional, pós-deploy (changelog, comunicado, ledger).
  changelog_hook: ""

review:
  # Vendors disponíveis para o review adversarial (revisor → auditor de vendor DIFERENTE).
  # Com um só vendor, o review degrada com aviso registrado — nunca é pulado em silêncio.
  vendors: ""
  # Superfície de segurança do projeto, em globs separados por vírgula (ex.: "auth/**,api/public/**").
  # Uma linha do File Manifest que casa um destes globs torna a revisão do DESIGN obrigatória
  # (sdd/bin/sdd-fluxo.sh review-design). Vazio = só os termos fixos do script (auth, login, token,
  # senha, password, jwt, GRANT, rota pública) e os globs de layers.sql.
  security_globs: ""

# Fluxo encadeado (sdd/templates/fragments/FLUXO_ENCADEADO.md). false = cada fase termina e mostra o
# Próximo passo, como sempre. true = com o gate da fase verde, a fase seguinte começa na mesma sessão,
# as perguntas [auto · de rotina] seguem a opção recomendada e vão para o recibo "Decidi sozinho"; as
# marcadas D1 a D5 continuam perguntadas e a release nunca começa sozinha. Não liga nem desliga o jeito
# de conversar das skills.
flow:
  autonomous: true

# Preenchido pelo sdd-open (`init`): agentes para os quais os adaptadores são gerados.
vendors: ""
# Editor e pasta de worktrees são usados pela skill de nova sessão (sdd-new-session).
editor: ""
worktree_base: ""

# Skill de engenharia de prompt usada pela fase Build quando o DESIGN inventaria prompts de
# producao. Vem preenchida com a skill que acompanha o pacote; troque pelo nome da sua se
# tiver outra. Vazio = a fase Build bloqueia o item de prompt e pede decisao, em vez de
# improvisar o texto que vai para producao.
prompts:
  builder_skill: "sdd-prompt-builder"
#!/usr/bin/env bash
# avaliador-guard.sh — o avaliador de contexto fresco só é despachado com a árvore COMMITADA.
#
# O avaliador usa o terminal para provar os critérios e pode restaurar arquivos do último commit
# (`git checkout -- …`) ou limpar o que não está no git: trabalho não commitado do build se perde.
# Com tudo commitado, restaurar devolve o próprio trabalho, e o alvo não se move durante a avaliação.
#
# Uso:
#   sdd/bin/avaliador-guard.sh [--root <dir>] [--permitir <prefixo>]…
# Sempre permitidos: sdd/reports/evidence/ (a evidência do próprio avaliador) e sdd/traces/ (o trace
# que o Verify Gate grava antes). --permitir acrescenta prefixos (ex.: um repositório que mantém as
# specs fora do git); nunca use um prefixo que contenha código do build.
#
# Exit: 0 limpo · 1 sujo (lista cada caminho e o comando de commit) · 2 não conferido (git falhou)
#       · 64 uso. SDD_AVALIADOR_GUARD=off → 0 com aviso (bypass humano, declarado no BUILD_REPORT).
# ⚠️ bash 3.2 · sem arrays.

set -uo pipefail

uso() {
  echo "🛑 ${1}" >&2
  printf 'RESULTADO: ERRO DE USO\n→ uso: sdd/bin/avaliador-guard.sh [--root <dir>] [--permitir <prefixo>]…\n' >&2
  exit 64
}

ROOT=""; PERMITIDOS="sdd/reports/evidence/
sdd/traces/
"
while [ $# -gt 0 ]; do
  case "${1}" in
    --root)     [ $# -ge 2 ] && [ -n "${2}" ] || uso "--root exige uma pasta"; ROOT="${2}"; shift 2 ;;
    --permitir) [ $# -ge 2 ] && [ -n "${2}" ] || uso "--permitir exige um prefixo"; PERMITIDOS="${PERMITIDOS}${2}
"; shift 2 ;;
    -h|--help)  sed -n '2,16p' "$0"; exit 64 ;;
    *)          uso "argumento inesperado: ${1}" ;;
  esac
done

if [ "$(printf '%s' "${SDD_AVALIADOR_GUARD:-}" | tr '[:upper:]' '[:lower:]')" = "off" ]; then
  echo "⚠️  guard desligado (SDD_AVALIADOR_GUARD=off) — declare no BUILD_REPORT."
  printf 'RESULTADO: VERDE\n→ o avaliador pode ser despachado; o bypass é decisão sua e fica registrado.\n'
  exit 0
fi

[ -n "${ROOT}" ] || ROOT="."
[ -d "${ROOT}" ] || uso "--root inexistente: ${ROOT}"
nao_conferido() {
  echo "⚠️  não consegui conferir a árvore: ${1}"
  printf 'RESULTADO: INCONCLUSIVO\n→ não despache o avaliador até o guard conferir; rode dentro do repositório do projeto.\n'
  exit 2
}
TOP="$(git -C "${ROOT}" rev-parse --show-toplevel 2>/dev/null)" || nao_conferido "${ROOT} não é um repositório git"
STATUS="$(git -C "${TOP}" -c core.quotepath=false status --porcelain --untracked-files=all 2>/dev/null)" \
  || nao_conferido "git status falhou"

permitido() { # $1=caminho → 0 se começa por um prefixo permitido
  while IFS= read -r pre; do
    [ -n "${pre}" ] || continue
    case "${1}" in "${pre}"*) return 0 ;; esac
  done <<EOF
${PERMITIDOS}
EOF
  return 1
}

SUJOS=""
while IFS= read -r linha; do
  [ "${#linha}" -ge 4 ] || continue
  st="$(printf '%s' "${linha}" | cut -c1-2)"
  resto="$(printf '%s' "${linha}" | cut -c4-)"
  case "${st}" in
    *R*|*C*) lados="$(printf '%s\n' "${resto}" | sed 's/ -> /\
/')" ;;
    *) lados="${resto}" ;;
  esac
  while IFS= read -r p; do
    p="$(printf '%s' "${p}" | sed 's/^"//; s/"$//')"
    [ -n "${p}" ] || continue
    permitido "${p}" && continue
    SUJOS="${SUJOS}${p}
"
  done <<EOF
${lados}
EOF
done <<EOF
${STATUS}
EOF

if [ -z "${SUJOS}" ]; then
  echo "✅ árvore commitada (fora de sdd/reports/evidence/, sdd/traces/ e dos prefixos permitidos)."
  printf 'RESULTADO: VERDE\n→ o avaliador pode ser despachado.\n'
  exit 0
fi
N="$(printf '%s' "${SUJOS}" | grep -c .)"
echo "🛑 ${N} arquivo(s) com mudança não commitada: o avaliador usa o terminal e pode restaurar arquivos do"
echo "   último commit — o que não foi commitado se perde. Commite antes de despachar (é rotina, não decisão):"
printf '%s' "${SUJOS}" | sed 's/^/   - /'
# o comando leva só o que o git ainda reconhece (no disco ou no índice): a origem de uma renomeação já
# staged não existe em nenhum dos dois, e `git add` com ela falharia
ADD=""
while IFS= read -r p; do
  [ -n "${p}" ] || continue
  if [ -e "${TOP}/${p}" ] || git -C "${TOP}" ls-files --error-unmatch -- "${p}" >/dev/null 2>&1; then
    ADD="${ADD}${p}
"
  fi
done <<EOF
${SUJOS}
EOF
args="$(printf '%s' "${ADD}" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/" | tr '\n' ' ')"
if [ -n "${args}" ]; then
  printf 'RESULTADO: VERMELHO\n→ git -C %s add -A -- %s&& git -C %s commit -m "wip(build): congelado para o avaliador"\n' \
    "${TOP}" "${args}" "${TOP}"
else
  # só remoções já no índice: nada a acrescentar, e `git add -A` sem caminho poria a árvore inteira no stage
  printf 'RESULTADO: VERMELHO\n→ git -C %s commit -m "wip(build): congelado para o avaliador"\n' "${TOP}"
fi
exit 1

