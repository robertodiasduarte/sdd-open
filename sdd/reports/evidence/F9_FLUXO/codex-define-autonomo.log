+#!/usr/bin/env bash
+# Contrato de aceite de DEFINE_EXEMPLO: executa a CLI real em arquivos temporários.
+set -eu
+GATE_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
+export GATE_ROOT
+command -v python3 >/dev/null 2>&1 || exit 3
+python3 -B - <<'PY'
+import csv
+import io
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import time
+
+CLI = Path(os.environ['GATE_ROOT']) / 'src/conciliador_extrato.py'
+HEADER = ['origem', 'linha', 'data', 'valor', 'motivo', 'linha_relacionada']
+E = 'data,descricao,valor\n'
+R = 'data,historico,debito,credito\n'
+
+
+def require(condition, message):
+    if not condition:
+        raise AssertionError(message)
+
+
+def run(extrato, razao, expected=0, missing=False):
+    require(CLI.is_file(), 'CLI ainda não implementada: src/conciliador_extrato.py')
+    with tempfile.TemporaryDirectory(prefix='gate-exemplo-') as folder:
+        folder = Path(folder)
+        e, r, out = (folder / name for name in ('extrato.csv', 'razao.csv', 'saida.csv'))
+        e.write_text(extrato, encoding='utf-8')
+        r.write_text(razao, encoding='utf-8')
+        before = (e.read_bytes(), r.read_bytes())
+        if expected:
+            out.write_bytes(b'relatorio anterior\n')
+        def invoke():
+            return subprocess.run(
+                [sys.executable, str(CLI), '--extrato', str(folder / 'ausente.csv') if missing else str(e),
+                 '--razao', str(r), '--saida', str(out)],
+                capture_output=True, timeout=15)
+        start = time.perf_counter()
+        result = invoke()
+        elapsed = time.perf_counter() - start
+        require(result.returncode == expected,
+                'exit esperado %s, obtido %s: %s' % (expected, result.returncode, result.stderr.decode('utf-8', 'replace')))
+        require((e.read_bytes(), r.read_bytes()) == before, 'entradas foram alteradas')
+        if expected:
+            require(result.stderr.strip(), 'erro sem diagnóstico em stderr')
+            require(out.read_bytes() == b'relatorio anterior\n', 'erro sobrescreveu relatório anterior')
+            return [], elapsed
+        require(out.is_file(), 'relatório não foi criado')
+        first = out.read_bytes()
+        reader = csv.DictReader(io.StringIO(first.decode('utf-8')))
+        require(reader.fieldnames == HEADER, 'cabeçalho de saída diverge do contrato')
+        rows = list(reader)
+        require(all(None not in row and all(v is not None for v in row.values()) for row in rows), 'CSV irregular')
+        again = invoke()
+        require(again.returncode == 0 and out.read_bytes() == first, 'reexecução não determinística')
+        require((e.read_bytes(), r.read_bytes()) == before, 'reexecução alterou entradas')
+        return rows, elapsed
+
+
+def row(origin, line, date, value, reason, related=''):
+    return dict(zip(HEADER, [origin, str(line), date, value, reason, str(related)]))
+
+
+def at001():
+    rows, _ = run(E+'2026-09-01,texto A,-10.00\n', R+'2026-09-01,texto B,10.00,0.00\n')
+    require(rows == [], 'par por data e valor absoluto não casou')
+
+
+def at002():
+    rows, _ = run(E+'2026-09-01,A,10.00\n', R+'2026-09-02,B,0.00,20.00\n')
+    require(rows == [row('extrato', 2, '2026-09-01', '10.00', 'ausente'),
+                     row('razao', 2, '2026-09-02', '20.00', 'ausente')], 'ausências incorretas')
+
+
+def at003():
+    rows, _ = run(E+'2026-09-01,A,10.00\n2026-09-01,B,20.00\n',
+                  R+'2026-09-01,C,10.00,0.00\n2026-09-01,D,21.00,0.00\n')
+    require(rows == [row('extrato', 3, '2026-09-01', '20.00', 'valor_diferente', 3),
+                     row('razao', 3, '2026-09-01', '21.00', 'valor_diferente', 3)], 'diferença inequívoca incorreta')
+
+
+def at004():
+    rows, _ = run(E+'2026-09-01,A,10.00\n2026-09-01,B,10.00\n',
+                  R+'2026-09-01,C,10.00,0.00\n2026-09-01,D,10.00,0.00\n')
+    require(rows == [], 'duplicados legítimos divergiram')
+    rows, _ = run(E+'2026-09-01,A,10.00\n2026-09-01,B,10.00\n', R+'2026-09-01,C,10.00,0.00\n')
+    require(rows == [row('extrato', 3, '2026-09-01', '10.00', 'ausente')], 'multiplicidade excedente incorreta')
+
+
+def at005():
+    rows, _ = run(E+'2026-09-01,A,10.00\n2026-09-01,B,20.00\n', R+'2026-09-01,C,30.00,0.00\n')
+    require(rows == [row('extrato', 2, '2026-09-01', '10.00', 'ausente'),
+                     row('extrato', 3, '2026-09-01', '20.00', 'ausente'),
+                     row('razao', 2, '2026-09-01', '30.00', 'ausente')], 'pareamento ambíguo inventado')
+
+
+def at006():
+    rows, _ = run(E+'2026-09-01,A,-0.10\n2026-09-01,B,0.20\n2026-09-02,C,0.30\n',
+                  R+'2026-09-01,D,0.00,0.10\n2026-09-01,E,0.20,0.00\n2026-09-02,F,0.30,0.00\n')
+    require(rows == [], 'centavos exatos ou sinal incorretos')
+    rows, _ = run(E+'2026-09-01,A,0.30\n', R+'2026-09-01,B,0.31,0.00\n')
+    require(len(rows) == 2 and all(r['motivo'] == 'valor_diferente' for r in rows), 'tolerância monetária indevida')
+
+
+def at007():
+    valid_r = R+'2026-09-01,B,1.00,0.00\n'
+    for invalid_e in ['data,valor\n2026-09-01,1.00\n', E+'2026-02-30,A,1.00\n',
+                      E+'2026-09-01,A,NaN\n', E+'2026-09-01,A,1.001\n', E+'2026-09-01,A,abc\n']:
+        run(invalid_e, valid_r, expected=2)
+    run(E+'2026-09-01,A,1.00\n', valid_r, expected=2, missing=True)
+    run(E, R+'2026-09-01,B,1.00,1.00\n', expected=2)
+    run(E, R+'2026-09-01,B,-1.00,0.00\n', expected=2)
+
+
+def at008():
+    e = E + ''.join('2026-09-01,item,%d.00\n' % n for n in range(1, 5001))
+    r = R + ''.join('2026-09-01,item,%d.00,0.00\n' % n for n in range(1, 5001))
+    rows, elapsed = run(e, r)
+    require(rows == [], 'carga conciliável gerou divergências')
+    require(elapsed < 5, '5000 linhas por entrada levaram %.3fs (limite <5s)' % elapsed)
+
+
+def at009():
+    rows, _ = run(E, R)
+    require(rows == [], 'entradas vazias com cabeçalho não produziram relatório vazio')
+
+
+failed = False
+for number, case in enumerate([at001, at002, at003, at004, at005, at006, at007, at008, at009], 1):
+    try:
+        case()
+        print('AT-%03d ✅' % number)
+    except Exception as error:
+        failed = True
+        print('AT-%03d ❌ %s' % (number, error))
+sys.exit(1 if failed else 0)
+PY
