#!/bin/bash
# Sabotagem em cópia temporária (git archive HEAD da worktree de avaliação); nunca toca a worktree.
set -u
W=/Users/robertoduarte/rdd-worktrees/sdd-open-f9-aval
T=$(mktemp -d "/tmp/aval sabot.XXXX") || exit 1
trap 'rm -rf "${T:?}"' EXIT
cd "$W" && git archive HEAD | tar -x -C "$T" && cd "$T" || exit 1
git init -q && git add -A && git -c user.name=aval -c user.email=aval@example.com commit -qm base || exit 1
roda() { SDD_TEST_BASH=/bin/bash /usr/bin/python3 -B -m unittest discover -s tests -p "$1" 2>&1 | grep -E '^(FAIL|ERROR):|^Ran |^OK|^FAILED'; return "${PIPESTATUS[0]}"; }
sab() { # sab <nome> <arquivo> <python-replace-old> <new> <pattern de teste>
  nome="$1"; arq="$2"; old="$3"; new="$4"; pat="$5"
  /usr/bin/python3 - "$arq" "$old" "$new" <<'PY' || { echo "🛑 $nome: trecho não achado"; return 1; }
import sys
p, old, new = sys.argv[1:]
t = open(p, encoding="utf-8").read()
if t.count(old) != 1: sys.exit(1)
open(p, "w", encoding="utf-8").write(t.replace(old, new))
PY
  echo "=== sabotagem: $nome ($arq)"; git diff --stat | tail -1
  roda "$pat"; rc=$?; echo "[sabotado: exit=$rc]"
  git checkout -q -- "$arq"; roda "$pat"; rc2=$?; echo "[restaurado por git checkout: exit=$rc2]"
  [ "$rc" -ne 0 ] && [ "$rc2" -eq 0 ]
}
F=0
sab "review-design: limiar 3 vira 4" sdd/bin/sdd-fluxo.sh 'if novos >= 3:' 'if novos >= 4:' 'test_fluxo.py' || F=$((F+1))
sab "loop: review inválida exige os 2 exits ≠ 0 (or → and)" sdd/bin/sdd-fluxo.sh 'if rev_ec != "0" or aud_ec != "0":' 'if rev_ec != "0" and aud_ec != "0":' 'test_fluxo.py' || F=$((F+1))
sab "seguir: Status Ready for removido" sdd/bin/sdd-fluxo.sh 'if not st.startswith("Ready for"):' 'if False:' 'test_fluxo.py' || F=$((F+1))
sab "decisoes-lint: regra da marca removida" sdd/bin/sdd-decisoes-lint.sh '    if not marcas:
        erros.append("sem marca' '    if False:
        erros.append("sem marca' 'test_decisoes_lint.py' || F=$((F+1))
sab "decisoes-lint: regra do rótulo invertida" sdd/bin/sdd-decisoes-lint.sh 'elif ROTULOS.get(m.group(1)) != m.group(2).strip():' 'elif ROTULOS.get(m.group(1)) == m.group(2).strip():' 'test_decisoes_lint.py' || F=$((F+1))
echo "sabotagens não pegas ou não restauradas: $F"
exit $F
