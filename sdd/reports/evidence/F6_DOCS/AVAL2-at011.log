--- script:
"""AT-011: as 7 skills de fase, sem a seção nova e com a versão normalizada, == v2.2.6 (texto)."""
import re, subprocess, sys, difflib
R = sys.argv[1]
SK = ["brainstorm","define","governanca","ux-review","design","build","release"]
def tira(t): return re.sub(r"\n## Por que cada regra existe[^\n]*\n.*?(?=\n## )", "", t, flags=re.S)
def norm(t):
    t = re.sub(r'(?m)^(\s*version:\s*)"?[0-9.]+"?', r'\1V', t)
    return re.sub(r"(sdd-[a-z-]+ v)[0-9]+\.[0-9]+\.[0-9]+", r"\1V", t)
falhas = 0
for s in SK:
    f = ".agents/skills/sdd-%s/SKILL.md" % s
    old = subprocess.run(["git","-C",R,"show","v2.2.6:"+f],capture_output=True,text=True,check=True).stdout
    new = open(R+"/"+f,encoding="utf-8").read()
    sec = re.search(r"\n## Por que cada regra existe[^\n]*\n(.*?)(?=\n## )", new, flags=re.S)
    itens = [l for l in sec.group(1).splitlines() if l.startswith("- **")] if sec else []
    a, b = norm(old), norm(tira(new))
    print("sdd-%s: itens=%d igual_a_v2.2.6=%s linhas=%d" % (s, len(itens), a == b, new.count("\n")))
    if a != b:
        falhas += 1; sys.stdout.writelines(difflib.unified_diff(a.splitlines(True), b.splitlines(True), "v2.2.6", "HEAD", n=1))
print("falhas=%d" % falhas); sys.exit(1 if falhas else 0)
