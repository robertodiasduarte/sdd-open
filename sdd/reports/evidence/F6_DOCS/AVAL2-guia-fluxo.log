--- script:
#!/bin/bash
# Segue o guia (seção 2 e seção 8) num HOME falso: instala com o pacote v2.2.6 e atualiza para aaae1b4.
set -u
C="$1"; W="$(mktemp -d)"; export HOME="$W/home"; mkdir -p "$HOME"
export GIT_CONFIG_GLOBAL="$W/gitconfig"; git config --global user.name t; git config --global user.email t@example.invalid
git clone -q "$C" "$HOME/sdd-open" && git -C "$HOME/sdd-open" checkout -q v2.2.6
P="$W/Honorarios"; mkdir -p "$P"; cd "$P"
run() { echo "\$ $*"; "$@" </dev/null 2>&1; echo "exit=$?"; }
echo "## 1. pasta sem git"
run bash ~/sdd-open/bin/sdd-open.sh init --vendors codex --dry-run
git init -q -b main
echo "## 2. --dry-run (guia :75-76: '+' e '~', mais a contagem do que já está certo; nada escrito)"
run bash ~/sdd-open/bin/sdd-open.sh init --vendors codex --dry-run
echo "arquivos depois do dry-run: $(ls -A | grep -v '^.git$' | wc -l)"
echo "## 3. sem --yes e sem terminal (guia :77-78)"
run bash ~/sdd-open/bin/sdd-open.sh init --vendors codex
echo "arquivos depois: $(ls -A | grep -v '^.git$' | wc -l)"
echo "## 4. --yes com o pacote v2.2.6"
bash ~/sdd-open/bin/sdd-open.sh init --vendors codex --yes </dev/null >/dev/null 2>&1; echo "init --yes exit=$?"
git add -A >/dev/null; git commit -qm base --no-verify
echo "## 5. 'Quando sair versão nova', passo 1: git pull (simulado: checkout de aaae1b4 no clone do pacote)"
git -C ~/sdd-open checkout -q aaae1b4; git -C ~/sdd-open log --oneline -1
echo "## simula sdd/bin de versão anterior (1 linha a mais em kb-dominios.py)"
echo '# antiga' >> sdd/bin/kb-dominios.py
echo "## passo 2: doctor"
run bash ~/sdd-open/bin/sdd-open.sh doctor
echo "## passo 3: apagar as skills e o sdd/bin apontados"
for s in $(bash ~/sdd-open/bin/sdd-open.sh doctor 2>&1 | sed -n 's/^⚠️  \(sdd-[a-z-]*\) .* no projeto, .*/\1/p'); do rm -r ".agents/skills/$s"; echo "apagado .agents/skills/$s"; done
rm sdd/bin/kb-dominios.py; echo "apagado sdd/bin/kb-dominios.py"
echo "## passo 4: init de novo com --yes (guia: 'copia de volta só o que você apagou')"
run bash ~/sdd-open/bin/sdd-open.sh init --vendors codex --yes --verbose
echo "## o que o init mudou além do que foi apagado (git status)"; git status --short | head -20
echo "## passo 5: sync --yes"
run bash ~/sdd-open/bin/sdd-open.sh sync --yes
run bash ~/sdd-open/bin/sdd-open.sh sync --check
run bash ~/sdd-open/bin/sdd-open.sh doctor
echo "## versões no projeto depois"
grep -h '^  version:' .agents/skills/sdd-{brainstorm,design,release}/SKILL.md
echo "## L2: sync sem --yes num projeto com adaptador claude desatualizado"
bash ~/sdd-open/bin/sdd-open.sh init --vendors claude --yes </dev/null >/dev/null 2>&1; echo "init claude exit=$?"
echo "x" >> .claude/skills/sdd-build/SKILL.md
run bash ~/sdd-open/bin/sdd-open.sh sync
run bash ~/sdd-open/bin/sdd-open.sh sync --yes
echo "## M1: starter global (HOME/.claude/skills, .agents/skills, .codex/skills com agents/openai.yaml)"
for d in .claude/skills .agents/skills .codex/skills; do mkdir -p "$HOME/$d/sdd-define/agents"; : > "$HOME/$d/sdd-define/agents/openai.yaml"; done
echo "\$ bash ~/sdd-open/bin/sdd-open.sh doctor | grep -c starter"; bash ~/sdd-open/bin/sdd-open.sh doctor 2>&1 | grep -c starter
mkdir -p .agents/skills/sdd-define/agents; : > .agents/skills/sdd-define/agents/openai.yaml
echo "\$ (marca do starter dentro do projeto) doctor | grep starter"; bash ~/sdd-open/bin/sdd-open.sh doctor 2>&1 | grep starter
rm -rf "$W"
