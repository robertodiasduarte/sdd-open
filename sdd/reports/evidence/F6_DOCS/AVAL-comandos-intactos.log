--- script:
import re, subprocess, sys, difflib
R = "/Users/robertoduarte/rdd-worktrees/sdd-open-f6-aval"
SK = ["brainstorm","define","governanca","ux-review","design","build","release"]
def tira_secao(t):
    # remove from '## Por que cada regra existe' up to (not incl.) next '## '
    return re.sub(r"\n## Por que cada regra existe[^\n]*\n.*?(?=\n## )", "", t, flags=re.S)
def norm_ver(t):
    t = re.sub(r'(?m)^(\s*version:\s*)"?[0-9.]+"?', r'\1V', t)
    t = re.sub(r"(sdd-[a-z-]+ v)[0-9]+\.[0-9]+\.[0-9]+", r"\1V", t)
    return t
falhas = 0
for s in SK:
    f = ".agents/skills/sdd-%s/SKILL.md" % s
    old = subprocess.run(["git","-C",R,"show","v2.2.6:"+f],capture_output=True,text=True,check=True).stdout
    new = open(R+"/"+f,encoding="utf-8").read()
    secoes_old = old.count("## Por que cada regra existe")
    a, b = norm_ver(old), norm_ver(tira_secao(new))
    # how much did removing section remove?
    sec = re.search(r"\n## Por que cada regra existe[^\n]*\n(.*?)(?=\n## )", new, flags=re.S)
    itens = [l for l in sec.group(1).splitlines() if l.startswith("- **")] if sec else []
    igual = a == b
    print("sdd-%s: secao_na_v2.2.6=%d itens=%d texto_normalizado_igual=%s" % (s, secoes_old, len(itens), igual))
    if not igual:
        falhas += 1
        sys.stdout.writelines(difflib.unified_diff(a.splitlines(True), b.splitlines(True), "v2.2.6", "HEAD", n=1))
print("falhas=%d" % falhas)
sys.exit(1 if falhas else 0)
