"""Sondas F31. uso: sondas.py <GRUPO>. Cada caso roda o lint de c747662 (VELHO) e o de HEAD (NOVO) no mesmo sandbox."""
import os, shutil, subprocess, sys, tempfile
AQ=os.path.dirname(os.path.abspath(__file__))
OLD,NEW=os.path.join(AQ,"lint_old.py"),os.path.join(AQ,"lint_new.py")
EV="sdd/reports/evidence/EX/"
CMD="bash gate.sh"
D=u"·"
def define():
    rows=""
    for i in range(1,10):
        rows+="| AT-00%d | Event-driven | **When** x, the system **shall** y | test |\n"%i
    rows+="| AT-0010 | Event-driven | **When** x, the system **shall** y | test |\n"
    rows+="| AT-001b | Event-driven | **When** x, the system **shall** y | cmd |\n"
    rows+="| AT-020 | Non-regression | The system **shall continue to** z | test |\n"
    rows+="| AT-030 | Event-driven | **When** x, the system **shall** y | manual-ux |\n"
    rows+="| AT-031 | Event-driven | **When** x, the system **shall** y | smoke |\n"
    return "# DEFINE\n\n| ID | Padrão | Critério (EARS) | Gate (`kind`) |\n|--|--|--|--|\n"+rows+"\n## Verify Gate\n\n```yaml\nverify_gate:\n  kind: test\n```\n"
def log(corpo="",rc=1,cmd=CMD): return "$ %s\n%s[exit=%d]\n"%(cmd,corpo,rc)
def caso(nome,ats,logs,esperado,esp_rc=0,cab=True,env=None,mostra=True,tabelas=1,extra=""):
    """ats: lista de ids ou (id, celula antes, celula evid, resultado). logs: {nome: str|bytes}. esperado: nº de avisos [casos avaliados]."""
    r=tempfile.mkdtemp(prefix="f31-"); 
    try:
        subprocess.run(["git","init","-q",r],check=True)
        def w(p,c):
            p=os.path.join(r,p); os.makedirs(os.path.dirname(p),exist_ok=True)
            open(p,"wb").write(c if isinstance(c,bytes) else c.encode("utf-8"))
        w("sdd/features/DEFINE_EX.md",define())
        linhas=""
        for a in ats:
            if isinstance(a,str): a=(a,"`evidence/EX/%s.antes.log`"%a,"`evidence/EX/%s.log`"%a,"true")
            at,an,ev,res=a
            linhas+=("| %s | x | %s | %s | %s |\n"%(at,an,res,ev)) if cab else ("| %s | x | %s | %s |\n"%(at,res,ev))
            if at+".log" not in logs: logs=dict(logs,**{at+".log":log("ok\n",0,(lambda b:(b if isinstance(b,str) else b.decode("cp1252","replace")).splitlines()[0][2:].strip())(logs.get(at+".antes.log","$ "+CMD)))})
        for n,c in logs.items(): w(EV+n,c)
        h="| ID | Critério | Antes | Resultado | Evidência |\n|--|--|--|--|--|\n" if cab else "| ID | Critério | Resultado | Evidência |\n|--|--|--|--|\n"
        w("sdd/reports/BUILD_REPORT_EX.md","# B\n\n"+(("## t\n\n"+h+linhas+"\n")*tabelas)+extra+"\navaliador: N.A. (1 camada)\n")
        def roda(s):
            p=subprocess.run([sys.executable,"-B",s,"sdd/reports/BUILD_REPORT_EX.md"],cwd=r,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,env=dict(os.environ,**(env or {})))
            return p.returncode,p.stdout.decode("utf-8","replace")
        ro,oo=roda(OLD); rn,on=roda(NEW)
        av=[l for l in on.splitlines() if "[casos avaliados]" in l]
        outros=lambda o:[l for l in o.splitlines() if "[casos avaliados]" not in l]
        ok=len(av)==esperado and rn==ro==esp_rc and outros(oo)==outros(on)
        print("%s %s | esperado: %d aviso(s), exit %d | observado: %d aviso(s), exit velho=%d novo=%d, resto da saida igual=%s"%("OK   " if ok else "DIVERGE",nome,esperado,esp_rc,len(av),ro,rn,outros(oo)==outros(on)))
        if mostra:
            for l in av: print("      "+l)
        if not ok:
            for l in on.splitlines(): print("      > "+l)
    finally: shutil.rmtree(r,ignore_errors=True)
