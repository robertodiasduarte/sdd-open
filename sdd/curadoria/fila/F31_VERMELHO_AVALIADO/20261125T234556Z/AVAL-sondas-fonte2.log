cd "$(dirname "$0")/cl" || exit 1
D=$(cd .. && pwd); n=0; dif=0; novos=0; antes=0
for r in $(git ls-files | grep '/BUILD_REPORT_[^/]*\.md$' | grep -v -e '^\.agents/' -e '^sdd/templates/'); do
  a=$(/usr/bin/python3 -B $D/lint_old.py $r 2>&1); ra=$?
  b=$(/usr/bin/python3 -B $D/lint_new.py $r 2>&1); rb=$?
  n=$((n+1)); [ "$ra" = "$rb" ] && [ "$a" = "$b" ] || { dif=$((dif+1)); echo "DIF $r $ra $rb"; }
  k=$(printf '%s\n' "$b" | grep -c 'casos avaliados'); novos=$((novos+k))
  echo "$ra $rb avisos_novos=$k $r"
done
echo "relatorios=$n diferentes=$dif avisos_da_classe_nova=$novos"
import importlib.util,re,sys,os,tempfile
W=sys.argv[1]
sp=importlib.util.spec_from_file_location("rl",W+"/sdd/bin/report-lint.py"); m=importlib.util.module_from_spec(sp); sp.loader.exec_module(m)
ruim=0
for p in (".agents/skills/sdd-define/SKILL.md",".agents/skills/sdd-build/web/references/disciplina-de-teste.md","sdd/templates/fragments/EVIDENCIA.md"):
    t=open(W+"/"+p,encoding="utf-8").read()
    ex=re.findall(r"`(AT-\d+[^`]*PASS[^`]*FAIL[^`]*)`",t)
    carga="erro de carga" in t and "FAIL" in t
    for e in ex:
        f=tempfile.mktemp(); open(f,"w",encoding="utf-8").write("$ x\n%s\n[exit=1]\n"%e)
        c=m.contagem_do_at(f,e.split()[0]); os.unlink(f); print(p,"|",e,"| leitor:",c)
        ruim+= c is None
    print(p,"| exemplos:",len(ex),"| cita erro de carga:",carga,"| linhas:",t.count("\n"),"| cita sdd/bin:","sdd/bin/report-lint" in t)
    ruim+= not ex or not carga
    if "disciplina" in p: ruim+= "sdd/bin" in t
print("ruim =",ruim); sys.exit(bool(ruim))
