$ cat /private/tmp/claude-501/-Users-robertoduarte-rdd-worktrees-sdd-open-f27-db-performance/1c932530-2974-4176-9efc-5abde2eaf63f/scratchpad/c3/d3.sh; bash /private/tmp/claude-501/-Users-robertoduarte-rdd-worktrees-sdd-open-f27-db-performance/1c932530-2974-4176-9efc-5abde2eaf63f/scratchpad/c3/d3.sh
# d3.sh — veredito ciclo 3: confere A1 e A2 do ciclo 2 e as observações leves, no diagnóstico de uma cópia git archive
# de HEAD a5a5c5e; supabase falso fora do projeto; senha e nome montados em tempo de execução e trocados na saída.
set -u
H=/private/tmp/claude-501/-Users-robertoduarte-rdd-worktrees-sdd-open-f27-db-performance/1c932530-2974-4176-9efc-5abde2eaf63f/scratchpad/c3/head
D=$H/sdd/bin/desempenho-diagnostico.sh
S=$(mktemp -d); SEG="$(printf '%s%s%s' Zk7 Wm2 Qx9)"; NOME="$(printf '%s%s' Mar ta)"
mkdir -p $S/bin $S/proj $S/fx && (cd $S/proj && git init -q)
printf '#!/bin/bash\nprintf "%%s\\n" "$*" >> "$SDD_FAKE_LOG"\ncase "$*" in --version) echo 2.100.1 ;; *) echo "[]" ;; esac\n' > $S/bin/supabase; chmod +x $S/bin/supabase
export PATH="$S/bin:$PATH" SDD_FAKE_LOG=$S/log
tapa() { sed "s/$SEG/<SENHA>/g; s/$NOME/<NOME>/g; s#$S#<TMP>#g"; }
roda() { : > $S/log; (cd $S/proj && bash $D "$@"); echo "[exit=$?] chamadas ao supabase: $(wc -l < $S/log | tr -d ' ')"; }
gravados() { (cd $S/proj && find . -path ./.git -prune -o -type f -print | tapa); (cd $S && find . -maxdepth 1 -name '*://*' | tapa); }
q() { /usr/bin/python3 -I -c "import json,sys; json.dump([{'query':sys.argv[2],'total_exec_time':'9s'}], open(sys.argv[1],'w'))" $S/fx/long-running-queries.json "$1"; }

echo "######## A1.1 --coletar --consentimento --saida <postgresql://postgres:SENHA@dbhost:5432/postgres>"
roda --coletar --consentimento --saida "postgresql://postgres:$SEG@dbhost:5432/postgres" > $S/o 2>&1; tapa < $S/o
echo "   senha na saída: $(grep -c "$SEG" $S/o) · arquivos gravados no projeto:"; gravados; echo "   (fim da lista)"
echo "######## A1.2 --ler <pasta> --saida <postgres://u:SENHA@h/db> (7 achados, passa do teto)"
/usr/bin/python3 -I -c "
import json,sys
json.dump([{'name':'lint_%d'%k,'level':'WARN','categories':['PERFORMANCE'],'detail':'x'} for k in range(7)], open(sys.argv[1],'w'))" $S/fx/advisors.json
roda --ler $S/fx --saida "postgres://u:$SEG@h/db" > $S/o 2>&1; tapa < $S/o
echo "   senha na saída: $(grep -c "$SEG" $S/o) · arquivos gravados no projeto:"; gravados; echo "   (fim da lista)"
echo "######## A1.3 variantes: --saida=URL, URL em --estatisticas-desde, URL em --ler, URL maiúscula, URL como arg solto"
for v in "--saida=postgres://u:$SEG@h/db" ; do roda --ler $S/fx "$v" > $S/o 2>&1; tapa < $S/o | sed -n '1p;$p'; echo "   senha: $(grep -c "$SEG" $S/o)"; done
roda --coletar --consentimento --estatisticas-desde "postgres://u:$SEG@h/db" > $S/o 2>&1; tapa < $S/o | sed -n '1p;$p'; echo "   senha: $(grep -c "$SEG" $S/o)"
roda --ler "POSTGRES://u:$SEG@h/db" > $S/o 2>&1; tapa < $S/o | sed -n '1p;$p'; echo "   senha: $(grep -c "$SEG" $S/o)"
roda --coletar --consentimento "postgresql://postgres:$SEG@dbhost/postgres" > $S/o 2>&1; tapa < $S/o | sed -n '1p;$p'; echo "   senha: $(grep -c "$SEG" $S/o)"
echo "######## A1.4 (sonda nova) string de conexão no formato chave=valor (libpq) como VALOR de --saida, com coleta"
roda --coletar --consentimento --saida "host=dbhost user=postgres password=$SEG dbname=postgres" > $S/o 2>&1; tapa < $S/o
echo "   senha na saída: $(grep -c "$SEG" $S/o) · arquivos gravados no projeto:"; gravados; echo "   (fim da lista)"
rm -f $S/proj/host=* 
echo "######## A1.5 (sonda nova) o mesmo, só --ler, com 7 achados (a tela cita o --saida)"
roda --ler $S/fx --saida "host=dbhost user=postgres password=$SEG dbname=postgres" > $S/o 2>&1; tapa < $S/o | grep -E '^…|^\[exit'
echo "   senha na saída: $(grep -c "$SEG" $S/o)"; rm -f $S/proj/host=*
rm -f $S/fx/advisors.json

echo "######## A2 máscara de texto vindo do banco (long-running-queries.json, depois --ler <pasta>)"
for e in "select * from c /* it's hot */ where nome = '$NOME'" \
         "select * from c where dir = 'C:\\' and nome = '$NOME'" \
         "select * from c where nome = '$NOME' -- don't cache" \
         "select * from c where a = E'it\\'s' and nome = '$NOME'" \
         "select \$\$it's\$\$, nome from c where nome = '$NOME'" \
         "select * from c /* a /* it's */ b */ where nome = '$NOME'" \
         "select \"it's\" from c where nome = '$NOME'" \
         "select * from \"o'brien\" where nome = '$NOME'" \
         "select * from c where k = 1e10 and m = 1_000_000 and h = 0x1F and z = 3.5e-2" \
         "select 1 /* PGPASSWORD=$SEG */" \
         "select 1 -- password = '$SEG'" ; do
  q "$e"; echo "--- entrada: $(printf '%s' "$e" | tapa)"
  roda --ler $S/fx > $S/o 2>&1; tapa < $S/o | grep -E '^   │|^\[exit'
  echo "   nome na saída: $(grep -c "$NOME" $S/o) · senha na saída: $(grep -c "$SEG" $S/o)"
done
rm -rf "${S:?}"
