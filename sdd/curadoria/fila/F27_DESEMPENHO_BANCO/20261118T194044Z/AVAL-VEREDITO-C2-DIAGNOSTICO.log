import re, sys, pathlib
raiz = pathlib.Path(sys.argv[1])
ruins = re.compile(r"(?i)\b(insert|update|delete|merge|alter|create|drop|truncate|grant|revoke|vacuum|reindex|cluster|refresh|pg_cancel_backend|pg_terminate_backend)\b")
total = 0
for f in sorted(raiz.rglob("*.md")):
    t = f.read_text(encoding="utf-8")
    for k, b in enumerate(re.findall(r"```sql\n(.*?)```", t, re.S), 1):
        total += 1
        s = re.sub(r"--[^\n]*", "", b); s = re.sub(r"'(?:[^']|'')*'", "''", s)
        m = ruins.findall(s)
        an = re.findall(r"(?i)\banalyze\b", s); ex_an = re.findall(r"(?i)\bexplain\s*\([^)]*analyze|explain\s+analyze", s)
        if m or (an and not ex_an):
            print("  ✗ %s bloco %d: %s %s" % (f.relative_to(raiz), k, m, an))
        if ex_an and not re.search(r"(?i)\bbegin\b.*\brollback\b", s, re.S) and re.search(r"(?i)\b(insert|update|delete)\b", s):
            print("  ✗ explain analyze de escrita fora de begin/rollback: %s bloco %d" % (f.relative_to(raiz), k))
print("  blocos sql lidos:", total)
PY

