echo "== A2.5 índice composto em que a chave é a 1ª coluna"
printf "create index p_dono on p (dono, id);\n" > $M/002.sql; varre
echo "== A2.6 foreign key (col) references, por alter table"
rm -f $M/002.sql
printf "create table u (id bigint primary key);\ncreate table p (id bigint primary key, dono bigint);\nalter table p add constraint fk foreign key (dono) references u(id);\n" > $M/001.sql; varre
echo "== A2.7 foreign key em create table, com índice parcial/único na coluna"
printf "create table u (id bigint primary key);\ncreate table p (id bigint primary key, dono bigint, foreign key (dono) references u (id));\ncreate unique index p_d on p (dono);\n" > $M/001.sql; varre
