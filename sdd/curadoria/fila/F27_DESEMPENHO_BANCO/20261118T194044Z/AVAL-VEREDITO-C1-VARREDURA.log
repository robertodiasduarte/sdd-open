echo "== A2.1 FK na coluna sem índice"
novo; echo "# x" > README.md; base
printf "create table u (id bigint primary key);\ncreate table p (\n  id bigint primary key,\n  dono bigint references u(id)\n);\n" > $M/001.sql; varre
echo "== A2.2 com índice na mesma migration"
printf "create index p_dono on p (dono);\n" >> $M/001.sql; varre
echo "== A2.3 com índice em outra migration"
printf "create table u (id bigint primary key);\ncreate table p (\n  id bigint primary key,\n  dono bigint references u(id)\n);\n" > $M/001.sql
printf "create index p_dono on public.p using btree (dono);\n" > $M/002.sql; varre
echo "== A2.4 índice composto em que a chave é a 2ª coluna"
