echo "== A1.12 P15 busca ilike '%x%' (JS) sem trigramas vs com gin_trgm_ops"
novo; echo "create table t (id bigint primary key, nome text);" > $M/001.sql; base
printf "const { data } = await supabase.from('t').select('*').ilike('nome', '%%' + q + '%%').limit(10)\n" > src/a.ts; varre
printf "create extension if not exists pg_trgm;\ncreate index t_nome on t using gin (nome gin_trgm_ops);\n" > $M/002.sql; varre
