# m2.sh — o HEAD mudou durante a avaliação (a5cf071, bloco UTF-8 do F16W2): os módulos da frente e o test_f16w2_saida,
# um por vez, numa cópia de git archive do commit fixo. Nunca a suíte inteira.
set -u
W=/Users/robertoduarte/rdd-worktrees/sdd-open-f27-db-performance
T=$(mktemp -d); git -C $W archive a5cf071 | tar -x -C $T; cd $T
for m in test_f16w2_saida test_desempenho_varredura test_desempenho_diagnostico test_desempenho_catalogo test_f27_textos; do
  SDD_TEST_BASH=/bin/bash /usr/bin/python3 -B -m unittest discover -s tests -p "$m.py" > $T/_out 2>&1; rc=$?
  echo "== $m @a5cf071: exit=$rc · $(grep -E '^Ran ' $T/_out) · $(tail -1 $T/_out)"
  [ $rc -ne 0 ] && grep -E '^(FAIL|ERROR):' $T/_out | head -10
done
rm -rf $T
