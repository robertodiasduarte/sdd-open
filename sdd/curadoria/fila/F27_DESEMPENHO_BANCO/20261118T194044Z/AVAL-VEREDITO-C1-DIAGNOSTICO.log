import re, sys
t = open(sys.argv[1], encoding="utf-8").read()
blocos = re.findall(r"```sql\n(.*?)```", t, re.S)
print("blocos sql:", len(blocos))
ruins = re.compile(r"(?i)\b(insert|update|delete|merge|alter|create|drop|truncate|grant|revoke|vacuum|reindex|cluster|refresh|pg_cancel_backend|pg_terminate_backend)\b")
for k, b in enumerate(blocos, 1):
    s = re.sub(r"--[^\n]*", "", b)
    s = re.sub(r"'(?:[^']|'')*'", "''", s)
    achou = ruins.findall(s)
    an = re.findall(r"(?i)\banalyze\b", s); ex_an = re.findall(r"(?i)\bexplain\s*\([^)]*analyze", s) + re.findall(r"(?i)\bexplain\s+analyze", s)
    if achou or len(an) > len(ex_an):
        print("  bloco %d: %s analyze=%d explain-analyze=%d" % (k, achou, len(an), len(ex_an)))
        print("   ", b.strip()[:300].replace("\n", " | "))
print("ok")
PY
