set -u
W=/private/tmp/claude-501/-Users-robertoduarte-rdd-worktrees-sdd-open-f27-db-performance/1c932530-2974-4176-9efc-5abde2eaf63f/scratchpad/copia-head   # cópia de git archive HEAD a5cf071
D=$W/sdd/bin/desempenho-diagnostico.sh
S=$(mktemp -d); mkdir -p $S/rows $S/results $S/lista $S/maiusc
R='[{"name":"public.ix_velho","size":"8 kB","percent_used":"0%","index_scans":0,"seq_scans":12,"unused":true},{"name":"public.ix_bom","size":"8 kB","percent_used":"99%","index_scans":9000,"seq_scans":1,"unused":false}]'
